---
import logoMarkUrl from "../../assets/brand/svg/tlac-folded-spark-mark.svg?url";
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import {
  canonicalUrl,
  organizationJsonLd,
  personJsonLd,
  siteDescription,
} from "../site/metadata";

type JsonLdNode = Record<string, unknown>;

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  jsonLd?: JsonLdNode | JsonLdNode[];
};

const {
  title = "The Little AI Company",
  description = siteDescription,
  canonicalPath = Astro.url.pathname,
  jsonLd = [],
} = Astro.props;
const pageUrl = canonicalUrl(canonicalPath);
const pageJsonLd = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [organizationJsonLd(), personJsonLd(), ...pageJsonLd],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href={logoMarkUrl} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="page">
      <SiteHeader />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
