---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  pillar?: string;
}
const { title, description, pillar } = Astro.props;
---

<BaseLayout title={`${title} — The Little AI Company`} description={description}>
  <article class="guide">
    <a class="back" href="/guides">← The Starter Kit</a>
    {pillar && <span class="eyebrow pillar">{pillar}</span>}
    <h1>{title}</h1>
    {description && <p class="dek">{description}</p>}
    <div class="prose">
      <slot />
    </div>
    <nav class="guide-foot" aria-label="Keep going">
      <a href="/start-here">← Start Here</a>
      <a href="/guides">All guides →</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .guide { max-width: 720px; margin: 0 auto; padding: 38px 0 24px; }
  .back { font-size: 14px; color: var(--muted); text-decoration: none; }
  .back:hover { color: var(--ink); }
  .pillar { display: block; margin: 22px 0 8px; color: var(--signal); }
  .guide h1 { font-size: clamp(31px, 5vw, 47px); font-weight: 900; }
  .dek { color: var(--muted); font-size: 18px; margin-top: 12px; }

  .prose { margin-top: 30px; font-size: 17px; }
  .prose :global(h2) { font-size: 25px; font-weight: 600; margin: 38px 0 12px; }
  .prose :global(h3) { font-size: 19px; font-weight: 600; margin: 26px 0 8px; }
  .prose :global(p) { margin: 14px 0; }
  .prose :global(ul), .prose :global(ol) { margin: 14px 0; padding-left: 24px; }
  .prose :global(li) { margin: 7px 0; }
  .prose :global(li > ul) { margin: 6px 0; }
  .prose :global(a) { color: var(--signal); text-decoration: underline; text-underline-offset: 2px; }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(em) { color: inherit; }
  .prose :global(blockquote) {
    margin: 20px 0;
    padding: 6px 18px;
    border-left: 3px solid var(--teal);
    background: var(--surface);
    border-radius: 0 8px 8px 0;
    color: var(--ink);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 1px 5px;
  }
  .prose :global(pre) {
    margin: 18px 0;
    padding: 16px 18px;
    background: #2A2118;
    color: #F4ECDD;
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.55;
  }
  .prose :global(pre code) { background: none; border: 0; padding: 0; color: inherit; font-size: 13.5px; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 30px 0; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 18px 0; font-size: 15px; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--line); padding: 9px 12px; text-align: left; vertical-align: top; }
  .prose :global(th) { background: var(--surface); font-weight: 600; }

  .guide-foot {
    display: flex; justify-content: space-between; gap: 16px;
    margin-top: 46px; padding-top: 20px; border-top: 1px solid var(--line);
    font-weight: 600; font-size: 15px;
  }
  .guide-foot a { color: var(--signal); text-decoration: none; }
  .guide-foot a:hover { text-decoration: underline; }
</style>
