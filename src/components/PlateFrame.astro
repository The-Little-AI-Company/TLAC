---
// The frame shared by Plate and SpecPlate: a raised surface, a hairline, and an optional italic caption underneath.
// A <figure> by default. Use tag="div" when the frame holds more than one thing, and let each thing carry its own caption.
// The caption is the `caption` prop, or the `caption` slot when it needs markup.
interface Props {
  tag?: 'figure' | 'div';
  caption?: string;
}
const { tag: Tag = 'figure', caption } = Astro.props;
const hasCaption = Boolean(caption) || Astro.slots.has('caption');
---

<Tag class="frame plate">
  <slot />
  {hasCaption && <figcaption class="caption">{caption}<slot name="caption" /></figcaption>}
</Tag>

<style>
  .plate {
    padding: 14px;
  }

  figcaption {
    padding: 12px 2px 0;
  }

  @media (max-width: 860px) {
    .plate {
      padding: var(--space-2);
    }
  }
</style>
