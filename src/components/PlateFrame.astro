---
// The frame shared by Plate and SpecPlate: a raised surface, a hairline, and an optional italic caption underneath.
// A <figure> by default, and the caption goes in the `caption` slot, as plain text or with markup. A frame that holds
// more than one thing is tag="div", and each thing carries its own caption: a div takes none, because a figcaption
// belongs in a figure, so giving it a caption stops the build.
interface Props {
  tag?: 'figure' | 'div';
}
const { tag: Tag = 'figure' } = Astro.props;
// A component that forwards its own caption slot passes one even when its caller gave none, so an empty caption is no caption.
const hasCaption = Astro.slots.has('caption') && (await Astro.slots.render('caption')).trim() !== '';
if (Tag === 'div' && hasCaption) {
  throw new Error('PlateFrame: a tag="div" frame takes no caption, because a <figcaption> belongs inside a <figure>.');
}
---

<Tag class="frame plate">
  <slot />
  {hasCaption && <figcaption class="caption"><slot name="caption" /></figcaption>}
</Tag>

<style>
  .plate {
    padding: 14px;
  }

  figcaption {
    padding: 12px 2px 0;
  }

  @media (max-width: 860px) {
    .plate {
      padding: var(--space-2);
    }
  }
</style>
