---
// The site footer: who runs this, where to reach them, and what the site does not do.
const links = [
  { href: 'mailto:jeff@littleaicompany.com', label: 'jeff@littleaicompany.com' },
  { href: 'https://github.com/The-Little-AI-Company', label: 'GitHub' },
  { href: 'https://jeffkazzee.dev', label: 'JeffKazzee.dev' },
];
---

<footer>
  <div class="wrap">
    <div class="row">
      <p>The Little AI Company · Jeff Kazzee · rural Idaho</p>
      <ul>
        {links.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </div>
    <p class="note">No cookies, no trackers, nothing loaded from anyone else.</p>
  </div>
</footer>

<style>
  footer {
    padding-block: 28px;
    border-top: 1px solid var(--rule);
    background: var(--ground-alt);
    font-size: 13px;
    color: var(--ink-faint);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--ink-soft);
  }

  a:hover {
    color: var(--accent-hover);
  }

  .note {
    margin-top: var(--space-2);
  }

  /* The single breakpoint is 860px, as in global.css. */
  @media (max-width: 860px) {
    footer {
      padding-block: var(--space-5);
    }

    .row {
      flex-direction: column;
      align-items: flex-start;
    }

    a {
      min-height: 44px;
    }
  }
</style>
