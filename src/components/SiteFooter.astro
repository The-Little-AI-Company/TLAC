---
// The site footer: who runs this, where to reach them, and what the site does not do.
import Dotted from './Dotted.astro';

const links = [
  { href: 'mailto:jeff@littleaicompany.com', label: 'jeff@littleaicompany.com' },
  { href: 'https://github.com/The-Little-AI-Company', label: 'GitHub' },
  { href: 'https://jeffkazzee.dev', label: 'JeffKazzee.dev' },
];
---

<footer>
  <div class="wrap">
    <div class="row">
      <p><Dotted text="The Little AI Company · Jeff Kazzee · rural Idaho" /></p>
      <ul>
        {links.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </div>
    <p class="note">This site sets no cookies, loads nothing from third parties, and keeps no analytics.</p>
  </div>
</footer>

<style>
  footer {
    padding-block: 28px;
    border-top: 1px solid var(--rule);
    background: var(--ground-alt);
    font-size: .8125rem;
    color: var(--ink-faint);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--ink-soft);
  }

  a:hover {
    color: var(--accent-hover);
  }

  .note {
    margin-top: var(--space-2);
    text-wrap: balance;
  }

  @media (max-width: 860px) {
    footer {
      padding-block: var(--space-5);
    }

    .row {
      gap: 0 var(--space-5);
    }

    ul {
      gap: 0 var(--space-4);
    }

    a {
      min-height: 44px;
    }
  }
</style>
