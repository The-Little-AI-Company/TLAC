---
// One ruled row of a Lanes list: a name in the display face, and what it means in the default slot.
interface Props {
  term: string;
}
const { term } = Astro.props;
---

<div class="lane">
  <dt class="title">{term}</dt>
  <dd class="text"><slot /></dd>
</div>

<style>
  /*
   * A wrapping row rather than a two-column grid: the name and its meaning sit side by side in a 1 to 2
   * ratio while the box is wide enough for both, and stack, name above meaning, when it is not.
   * No breakpoint, so a narrow column on a wide screen stacks as well as a phone does.
   */
  .lane {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--rule);
  }

  dt {
    flex: 1 1 13rem;
    min-width: 0;
  }

  dd {
    flex: 2 1 26rem;
    min-width: 0;
  }

  @media (max-width: 860px) {
    .lane {
      padding: 20px 0;
    }
  }
</style>
