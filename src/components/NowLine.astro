---
// One sentence about what is happening now, led by a status dot.
import type { Tone } from '../data/status';

interface Props {
  tone?: Extract<Tone, 'live' | 'wip'>;
}
const { tone = 'live' } = Astro.props;
---

<p class:list={['now', `now--${tone}`]}><slot /></p>

<style>
  /* The dot is inline, so a sentence that wraps (or is centered, as in the home hero) keeps it beside its first word. */
  .now {
    font-size: .9375rem;
    color: var(--ink-soft);
  }

  .now::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 10px;
    border-radius: 50%;
    background: var(--status-live);
    vertical-align: middle;
  }

  .now--wip::before {
    background: var(--status-wip);
  }

  /* Forced colors repaint backgrounds as the page color, so the dot needs a border to stay visible. */
  @media (forced-colors: active) {
    .now::before {
      border: 4px solid;
    }
  }
</style>
