---
// One sentence about what is happening now, led by a status dot.
import type { Tone } from '../data/status';

interface Props {
  tone?: Extract<Tone, 'live' | 'wip'>;
}
const { tone = 'live' } = Astro.props;
---

<p class={`now now--${tone}`}><slot /></p>

<style>
  /* The dot is inline, so a sentence that wraps (or is centered, as in the home hero) keeps it beside its first word. */
  .now {
    font-size: 15px;
    color: var(--ink-soft);
    text-wrap: balance;
  }

  .now::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 10px;
    border-radius: 50%;
    background: var(--status-live);
    vertical-align: middle;
  }

  .now--wip::before {
    background: var(--status-wip);
  }
</style>
