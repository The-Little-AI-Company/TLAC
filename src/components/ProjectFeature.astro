---
// One project as a short case study: a plate beside its numeral, name, a few paragraphs, status and link.
// Put a Plate or SpecPlate in the `media` slot and `<p class="text">` paragraphs in the default slot.
import type { Tone } from '../data/status';
import Button from './Button.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  numeral: string;
  title: string;
  tone: Tone;
  status: string;
  href: string;
  linkLabel: string;
  reverse?: boolean;
}
const { numeral, title, tone, status, href, linkLabel, reverse = false } = Astro.props;
---

<article class:list={['feature', { 'feature--reverse': reverse }]}>
  <div class="media"><slot name="media" /></div>
  <div class="copy">
    <p class="numeral">{numeral}</p>
    <h2 class="display-l">{title}</h2>
    <slot />
    <p class="badge-row"><StatusBadge tone={tone} label={status} /></p>
    <p class="link-row"><Button href={href} size="sm">{linkLabel}</Button></p>
  </div>
</article>

<style>
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: center;
  }

  .feature--reverse {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
  }

  .feature--reverse .media {
    order: 2;
  }

  .numeral {
    margin-bottom: 14px;
    font: 400 22px/1 var(--font-display-italic);
    color: var(--accent);
  }

  .display-l {
    margin-bottom: 14px;
  }

  .badge-row,
  .link-row {
    margin-top: 22px;
  }

  /* The single breakpoint is 860px, as in global.css. */
  @media (max-width: 860px) {
    .feature,
    .feature--reverse {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }

    .feature--reverse .media {
      order: 0;
    }
  }
</style>
