---
// The recorded state of a project: a dot and a word. The word is always shown, so color is never the only signal.
import type { Tone } from '../data/status';
import Dotted from './Dotted.astro';

interface Props {
  tone: Tone;
  label: string;
}
const { tone, label } = Astro.props;
---

<span class:list={['status', `status--${tone}`]}><i aria-hidden="true"></i><span><Dotted text={label} /></span></span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: .8125rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .status i {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--status-live);
  }

  .status--wip i {
    background: var(--status-wip);
  }

  .status--alpha i,
  .status--demo i {
    border: 1.5px solid var(--ink-soft);
    background: transparent;
  }

  .status--retired {
    color: var(--ink-faint);
  }

  .status--retired i {
    border: 1px solid var(--ink-faint);
    background: transparent;
  }

  /* Forced colors repaint every background as the page color, so a filled dot needs a border to stay a filled dot. */
  @media (forced-colors: active) {
    .status:not(.status--alpha, .status--demo, .status--retired) i {
      border: 4px solid;
    }
  }
</style>
