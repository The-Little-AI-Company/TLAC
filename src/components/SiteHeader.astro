---
import logoMarkUrl from "../../assets/brand/svg/tlac-folded-spark-mark.svg?url";
import { primaryNavigation } from "../site/navigation";
---

<header class="site-header" aria-label="Site header">
  <a class="brand" href="/" aria-label="The Little AI Company home">
    <img src={logoMarkUrl} width="88" height="88" alt="" loading="eager" />
    <span>The Little AI Company</span>
  </a>
  <nav class="nav" aria-label="Primary navigation">
    {
      primaryNavigation.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))
    }
  </nav>
</header>
