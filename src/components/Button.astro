---
// A link that looks like a button: filled for the main action, outlined for the next, underlined for the quiet one.
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'text';
  size?: 'md' | 'sm';
  block?: boolean;
}
const { href, variant = 'secondary', size = 'md', block = false } = Astro.props;
---

<a class:list={['btn', `btn--${variant}`, { 'btn--sm': size === 'sm', 'btn--block': block }]} href={href}>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 46px;
    padding: 0 22px;
    border: 1px solid var(--field);
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--ink);
    font: 600 15px/1 var(--font-text);
    text-decoration: none;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .btn:hover {
    border-color: var(--ink);
  }

  .btn--sm {
    min-height: 40px;
    padding: 0 var(--space-4);
    font-size: 14px;
  }

  .btn--block {
    display: flex;
    width: 100%;
    min-height: 48px;
  }

  .btn--primary {
    background: var(--accent-fill);
    border-color: var(--accent-fill);
    color: var(--on-accent);
  }

  .btn--primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  .btn--text {
    padding: 0 2px;
    border-width: 0;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .btn--text:hover {
    color: var(--accent-hover);
  }

  /* The single breakpoint is 860px, as in global.css. */
  @media (max-width: 860px) {
    :global(.actions) > .btn {
      width: 100%;
      min-height: 48px;
    }
  }
</style>
