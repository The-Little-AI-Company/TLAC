---
// A link that looks like a button: filled for the main action, outlined for the next.
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'sm';
}
const { href, variant = 'secondary', size = 'md' } = Astro.props;
---

<a class:list={['btn', `btn--${variant}`, { 'btn--sm': size === 'sm' }]} href={href}>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 46px;
    padding: 0 22px;
    border: 1px solid var(--field);
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--ink);
    font: 600 .9375rem/1 var(--font-text);
    text-decoration: none;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .btn:hover {
    border-color: var(--ink);
  }

  .btn--sm {
    min-height: 40px;
    padding: 0 var(--space-4);
    font-size: .875rem;
  }

  .btn--primary {
    background: var(--accent-fill);
    border-color: var(--accent-fill);
    color: var(--on-accent);
  }

  .btn--primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  /* Forced colors give every border the same color, so the main action keeps its weight in the border. */
  @media (forced-colors: active) {
    .btn--primary {
      border-width: 2px;
    }
  }

  /* A phone gets taller targets. The row of buttons is a grid there, so they also fill its width. */
  @media (max-width: 860px) {
    .btn:not(.btn--sm) {
      min-height: 48px;
    }
  }
</style>
