---
// The site header: the brand on one side and the four page links on the other. No menu button, so it wraps to two rows on a phone.
import Mark from './Mark.astro';

interface Props {
  // Pathname of the page being rendered, so its link can say aria-current.
  current: string;
}
const { current } = Astro.props;

const links = [
  { href: '/callout/', label: 'Callout' },
  { href: '/vivary/', label: 'Vivary' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

// The dev server answers `/callout` as well as `/callout/`; both are the same page.
const here = current.endsWith('/') ? current : `${current}/`;
const pageFor = (href: string) => (here === href ? 'page' : undefined);
---

<header>
  <nav class="wrap nav" aria-label="Main">
    <a class="brand" href="/" aria-current={pageFor('/')}>
      <Mark size={24} />
      <span>The Little AI Company</span>
    </a>
    <ul class="links">
      {links.map(({ href, label }) => (
        <li>
          <a href={href} aria-current={pageFor(href)}>{label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 400 1.5rem/1 var(--font-display);
    letter-spacing: -.005em;
    text-decoration: none;
  }

  .links {
    display: flex;
    gap: 30px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    padding-block: var(--space-2);
    color: var(--ink-soft);
    font-size: .9375rem;
    line-height: 1.55;
    text-decoration: none;
  }

  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  @media (max-width: 860px) {
    .nav {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding-block: var(--space-4) var(--space-2);
    }

    .brand {
      font-size: 1.25rem;
    }

    .links {
      flex-wrap: wrap;
      gap: 0 var(--space-5);
    }

    .links a {
      min-height: 44px;
    }
  }
</style>
