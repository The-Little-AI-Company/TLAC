---
// A real screenshot in a frame, like a plate in a book, with a dated caption. Lazy unless it is the first thing on the page.
import PlateFrame from './PlateFrame.astro';

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
  eager?: boolean;
  sizes?: string;
  srcset?: string;
}
const { src, alt, width, height, caption, eager = false, sizes, srcset } = Astro.props;
---

<PlateFrame caption={caption}>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    sizes={sizes}
    srcset={srcset}
    decoding="async"
    loading={eager ? undefined : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
  />
</PlateFrame>

<style>
  img {
    width: 100%;
  }
</style>
