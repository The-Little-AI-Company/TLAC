---
// A real screenshot in a frame, like a plate in a book, with a dated caption. Lazy unless it is the first thing on the page.
// Pass `srcset` with a smaller file for phones. The default `sizes` is the width a plate draws in a feature or a tool header.
// The caption goes in the `caption` slot, as plain text or with markup, and the frame sets it under the picture.
import PlateFrame from './PlateFrame.astro';

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  eager?: boolean;
  sizes?: string;
  srcset?: string;
}
const {
  src,
  alt,
  width,
  height,
  eager = false,
  sizes = '(max-width: 860px) calc(100vw - 50px), 524px',
  srcset,
} = Astro.props;
---

<PlateFrame>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    srcset={srcset}
    sizes={srcset ? sizes : undefined}
    decoding="async"
    loading={eager ? undefined : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
  />
  <slot name="caption" slot="caption" />
</PlateFrame>

<style>
  img {
    width: 100%;
  }
</style>
