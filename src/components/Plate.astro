---
import type { Tool } from '../data/tools';
import { latestVersion } from '../data/tools';

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
const version = await latestVersion(tool.version);
---

<article class="plate" aria-labelledby={`plate-${tool.slug}`}>
  <header class="plate-head">
    <h3 id={`plate-${tool.slug}`}><a href={`/${tool.slug}/`}>{tool.name}</a></h3>
    <span class="stamp">{version ?? tool.status}</span>
  </header>
  <p class="plate-tagline">{tool.tagline}</p>
  <p class="plate-summary">{tool.summary}</p>
  <dl class="facts">
    <dt>Runs on</dt>
    <dd>{tool.platform}</dd>
    <dt>Status</dt>
    <dd>{tool.status}</dd>
    <dt>License</dt>
    <dd>MIT, source on <a href={tool.repo}>GitHub</a></dd>
  </dl>
  <p class="plate-actions">
    <a class="action" href={tool.primary.href}>{tool.primary.label}</a>
    <a class="plate-more" href={`/${tool.slug}/`}>More about {tool.name}</a>
  </p>
</article>

<style>
  .plate {
    border: 3px solid var(--ink);
    padding: 22px 26px 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .plate-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 3px solid var(--ink);
    padding-bottom: 12px;
  }

  .plate-head h3 {
    font-size: 2.6rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .plate-head a {
    text-decoration: none;
  }

  .plate-tagline {
    font-weight: 600;
    font-size: 1.15rem;
  }

  .plate-summary {
    color: var(--steel);
  }

  .plate-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: auto;
    padding-top: 6px;
  }

  .plate-more {
    font-size: 0.95rem;
  }
</style>
