---
// A section of a long page: the heading and a short introduction in a narrow column, the matter beside it in a wide one.
// Put the introduction in the `intro` slot and the content (Lanes, a lede, a button) in the default slot.
interface Props {
  heading: string;
  // Lets a link land on the section.
  id?: string;
}
const { heading, id } = Astro.props;
---

<section id={id} class="section">
  <div class="wrap split">
    <div class="intro">
      <h2 class="heading">{heading}</h2>
      <slot name="intro" />
    </div>
    <div class="matter"><slot /></div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-7);
    /* The heading's baseline sits on the baseline of the first line of the content: the first lane name, or the first line of a paragraph. */
    align-items: first baseline;
  }

  /* With no introduction under it the heading is the whole column, so the grid gap alone separates it from the content. */
  .intro > .heading:last-child {
    margin-bottom: 0;
  }

  /* In one column each part has a row of its own, so there is nothing to align. */
  @media (max-width: 860px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
  }
</style>
