---
// Header of a tool page: status, name, tagline and the two ways in.
import type { Tool } from '../data/tools';
import { latestVersion } from '../data/tools';
import Button from './Button.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
const version = await latestVersion(tool.version);
---

<section class="page-head">
  <div class="wrap">
    <p class="badge"><StatusBadge tone={version ? 'shipped' : 'wip'} label={version ?? tool.status} /></p>
    <h1 class="display-l">{tool.name}</h1>
    <p class="lede">{tool.tagline}</p>
    <div class="actions">
      <Button href={tool.primary.href} variant="primary">{tool.primary.label}</Button>
      <Button href={tool.repo}>Source on GitHub</Button>
    </div>
  </div>
</section>

<style>
  .badge {
    margin-bottom: var(--space-4);
  }
</style>
