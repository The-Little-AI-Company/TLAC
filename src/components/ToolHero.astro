---
// Header of a tool page: its recorded status, name, tagline, summary and the two ways in.
// Whatever is in the default slot (a Plate, or a SpecPlate for a tool with no screenshot) is shown beside the text.
import type { Tool } from '../data/tools';
import { stampedStatus } from '../data/tools';
import Button from './Button.astro';
import PageHead from './PageHead.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
const status = await stampedStatus(tool);
// A tool with an open release queue points there. One without points at its source.
const second = tool.queue
  ? { label: 'Release queue on GitHub', href: tool.queue }
  : { label: 'Source on GitHub', href: tool.repo };
---

<PageHead title={tool.name} lede={tool.tagline} tagline>
  <p slot="before" class="badge-row"><StatusBadge tone={tool.tone} label={status} /></p>
  <p class="text-sm summary">{tool.summary}</p>
  <div class="actions">
    <Button href={tool.primary.href} variant="primary">{tool.primary.label}</Button>
    <Button href={second.href}>{second.label}</Button>
  </div>
  {Astro.slots.has('default') && <div slot="media"><slot /></div>}
</PageHead>

<style>
  .badge-row {
    margin-bottom: var(--space-4);
  }

  .summary {
    margin-top: var(--space-4);
  }

  .actions {
    margin-top: var(--space-6);
  }

  @media (max-width: 860px) {
    .actions {
      margin-top: var(--space-5);
    }
  }
</style>
