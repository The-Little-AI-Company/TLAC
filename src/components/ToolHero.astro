---
import type { Tool } from '../data/tools';
import { latestVersion } from '../data/tools';

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
const version = await latestVersion(tool.version);
---

<section class="tool-hero">
  <div class="wrap">
    <p class="tool-kicker">
      {version && <span class="stamp">{version}</span>}
      <span class="stamp">{tool.status}</span>
      <span class="stamp">{tool.platform}</span>
    </p>
    <h1>{tool.name}</h1>
    <p class="lede">{tool.tagline}</p>
    <p class="tool-actions">
      <a class="action" href={tool.primary.href}>{tool.primary.label}</a>
      <a class="action action-quiet" href={tool.repo}>Source on GitHub</a>
    </p>
  </div>
</section>

<style>
  .tool-hero {
    padding: 48px 0 56px;
  }

  .tool-hero .wrap {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .tool-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tool-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
</style>
