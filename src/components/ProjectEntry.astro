---
// One row of a contents list: a small framed thumbnail, the name, one line, its status and its address.
// Use inside <ol class="contents">, or spread a record from src/data/projects.ts.
import type { Project } from '../data/projects';
import StatusBadge from './StatusBadge.astro';

type Props = Project;
const { image, imageAlt, width, height, title, line, tone, status, href, linkLabel } = Astro.props;
---

<li class="entry">
  <div class="thumb">
    <img src={image} alt={imageAlt} width={width} height={height} loading="lazy" decoding="async" />
  </div>
  <div class="copy">
    <h3 class="title">{title}</h3>
    <p class="text-sm">{line}</p>
  </div>
  <div class="meta">
    <StatusBadge tone={tone} label={status} />
    <a href={href}>{linkLabel}</a>
  </div>
</li>

<style>
  .entry {
    display: grid;
    grid-template-columns: 150px 1fr auto;
    gap: 28px;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px solid var(--rule);
  }

  .entry:first-child {
    border-top: 1px solid var(--rule);
  }

  .thumb {
    padding: 5px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-none);
    background: var(--raised);
  }

  .thumb img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .text-sm {
    margin-top: 4px;
  }

  .meta {
    display: grid;
    gap: var(--space-2);
    justify-items: end;
    font-size: 14px;
    text-align: right;
  }

  .meta a {
    overflow-wrap: anywhere;
  }

  /* The single breakpoint is 860px, as in global.css. */
  @media (max-width: 860px) {
    .entry {
      grid-template-columns: 88px 1fr;
      gap: 14px;
      padding: 14px 0;
    }

    .title {
      font-size: 22px;
    }

    .meta {
      grid-column: 2;
      justify-items: start;
      text-align: left;
    }
  }
</style>
