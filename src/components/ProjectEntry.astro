---
// One row of a contents list: a small framed thumbnail, the name, one line, its status and its address.
// Use inside a plain <ol> (the home page's is class="contents"), or spread a record from src/data/projects.ts.
import type { Project } from '../data/projects';
import StatusBadge from './StatusBadge.astro';

type Props = Project;
const { image, thumb, imageAlt, width, height, title, line, tone, status, href, linkLabel } = Astro.props;
// The width scripts/images.mjs writes the thumbnails at (`pnpm images`). Change the two together.
const THUMB_WIDTH = 320;
---

<li class="entry">
  <div class="frame thumb">
    <img
      src={image}
      srcset={`${thumb} ${THUMB_WIDTH}w, ${image} ${width}w`}
      sizes="(max-width: 860px) 88px, 150px"
      alt={imageAlt}
      width={width}
      height={height}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="copy">
    <h3 class="title">{title}</h3>
    <p class="text-sm">{line}</p>
  </div>
  <div class="meta">
    <StatusBadge tone={tone} label={status} />
    <a href={href}>{linkLabel}</a>
  </div>
</li>

<style>
  .entry {
    display: grid;
    grid-template-columns: 150px 1fr auto;
    gap: 28px;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px solid var(--rule);
  }

  .entry:first-child {
    border-top: 1px solid var(--rule);
  }

  .thumb {
    padding: 5px;
  }

  .thumb img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .text-sm {
    margin-top: 4px;
  }

  .meta {
    display: grid;
    gap: var(--space-2);
    justify-items: end;
    font-size: .875rem;
    text-align: right;
  }

  .meta a {
    overflow-wrap: anywhere;
  }

  /* Beside the text, a long address wraps at its hyphens in a narrow column rather than taking the width the description needs. */
  @media (min-width: 861px) {
    .meta a {
      max-width: 18ch;
    }
  }

  @media (max-width: 860px) {
    .entry {
      grid-template-columns: 88px 1fr;
      gap: 14px;
      padding: 14px 0;
    }

    .meta {
      grid-column: 2;
      justify-items: start;
      text-align: left;
    }
  }
</style>
