---
// Text with its middle dots set as separators. Write the string with " · " and the page keeps those spaces, so copy and paste,
// find in page and a screen reader meet "Released · v0.2.0" and not "Released·v0.2.0". The dot fills its whole advance
// and the font's space is only 0.2em, which is narrow beside a mark this small, so the dot gets a margin on each side too.
// The space before the dot sits inside the separator and the separator does not wrap, so a line never starts with a dot.
interface Props {
  text: string;
}
const { text } = Astro.props;
const parts = text.split(' · ');
---

{parts.map((part, i) => <>{i > 0 && <><span class="sep">{' ·'}</span>{' '}</>}{part}</>)}

<style>
  /* 0.2em for the space and this margin make 0.35em between the dot and the word on either side. */
  .sep {
    margin-inline: .15em;
    white-space: nowrap;
  }
</style>
