---
// The top of an inner page: the h1 and the lede under it, with room for what follows.
// Anything in the default slot comes after the lede (buttons, a summary). The `before` slot comes above the h1 (a status badge).
// A `media` slot sits beside the text when both have room, and under it when they do not.
interface Props {
  title: string;
  lede: string;
  // The lede is a tagline, so it is set in ink and the text under it reads as secondary. Each of its sentences stays on one line.
  tagline?: boolean;
  // Center the block, and the page around it, as the 404 page does.
  center?: boolean;
}
const { title, lede, tagline = false, center = false } = Astro.props;
const hasMedia = Astro.slots.has('media');
// A tagline breaks between its sentences and nowhere inside one: "Your projects. Your / agents. Your machine." is wrong.
const sentences = lede.split(/(?<=[.!?])\s+/);
---

<section class:list={['page-head', { 'page-head--center': center }]}>
  <div class:list={['wrap', { 'with-media': hasMedia }]}>
    <div class="copy">
      <slot name="before" />
      <h1 class="display-l">{title}</h1>
      <p class:list={['lede', { tagline }]}>{tagline ? sentences.map((sentence, i) => <>{i > 0 && ' '}<span class="nowrap">{sentence}</span></>) : lede}</p>
      <slot />
    </div>
    {hasMedia && <div class="media"><slot name="media" /></div>}
  </div>
</section>

<style>
  .page-head {
    padding-block: var(--space-8) var(--space-7);
  }

  /* A page head's lede is two or three lines, so they are balanced and the last is never left holding "of it." */
  .lede {
    text-wrap: balance;
  }

  .tagline {
    color: var(--ink);
  }

  /*
   * The copy and the media sit side by side only when each has room: 26rem for the copy, which keeps the two buttons on
   * one row, and 28rem for the media, which grows a little faster, as the plate does in a project feature on the home page.
   * Below that the media wraps under the copy. No breakpoint, so it stacks when the width says so, not when the device does.
   */
  .with-media {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6) var(--space-7);
    align-items: start;
  }

  .with-media > .copy {
    flex: 1 1 27rem;
    min-width: 0;
  }

  .with-media > .media {
    flex: 1.2 1 28rem;
    min-width: 0;
  }

  /*
   * A page that is one centered block (the 404 page) sits in the middle of the space between the header and the footer.
   * The buttons are the caller's, in the default slot, so their rule reaches them with :global(). So does main's.
   */
  .page-head--center {
    text-align: center;
  }

  .page-head--center .lede,
  .page-head--center :global(.actions) {
    margin-inline: auto;
  }

  .page-head--center :global(.actions) {
    justify-content: center;
  }

  :global(main:has(> .page-head--center)) {
    display: grid;
    align-content: center;
  }

  @media (max-width: 860px) {
    .page-head {
      padding-block: var(--space-6) var(--space-7);
    }
  }
</style>
