---
// The top of an inner page: the h1 and the lede under it, with room for what follows.
// Anything in the default slot comes after the lede (buttons, a summary). The `before` slot comes above the h1 (a status badge).
// A `media` slot sits beside the text on a wide screen, and under it on a phone.
interface Props {
  title: string;
  lede: string;
  // The lede is a tagline, so it is set in ink and the text under it reads as secondary.
  tagline?: boolean;
  // Center the block, and the page around it, as the 404 page does. The rules live in global.css with the rest of the layout.
  center?: boolean;
}
const { title, lede, tagline = false, center = false } = Astro.props;
const hasMedia = Astro.slots.has('media');
---

<section class:list={['page-head', { 'page-head--center': center }]}>
  <div class:list={['wrap', { 'with-media': hasMedia }]}>
    <div class="copy">
      <slot name="before" />
      <h1 class="display-l">{title}</h1>
      <p class:list={['lede', { tagline }]}>{lede}</p>
      <slot />
    </div>
    {hasMedia && <div class="media"><slot name="media" /></div>}
  </div>
</section>

<style>
  /* A page head's lede is two or three lines, so they are balanced and the last is never left holding "of it." */
  .lede {
    text-wrap: balance;
  }

  .tagline {
    color: var(--ink);
  }

  /* The same two columns as a project feature on the home page, copy first. */
  .with-media {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: var(--space-7);
    align-items: center;
  }

  @media (max-width: 860px) {
    .with-media {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }
</style>
