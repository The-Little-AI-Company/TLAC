---
const zo = [
  { href: 'https://zocomputer101.wiki', label: 'Zo 101' },
  { href: 'https://www.zo-cookbook.space', label: 'Zo Cookbook' },
  { href: 'https://zo-computer.cello.so/X9jcdFXqh9Z', label: 'Subscribe to Zo Computer' },
];
---

<footer>
  <div class="wrap foot">
    <div class="foot-brand">
      <img src="/brand/mark/tlac-owl-mark-128.png" alt="" width="36" height="36" />
      <span>The Little AI Company</span>
    </div>
    <nav class="foot-links" aria-label="Footer">
      <a href="/projects">Projects</a>
      <a href="/guides">Guides</a>
      <a href="/about">About</a>
      <a href="/services">Work with us</a>
      <a href="/contact">Contact</a>
    </nav>
  </div>

  <div class="wrap foot-zo">
    <span class="foot-zo-label">Learning Zo Computer? Explore:</span>
    <nav aria-label="Zo resources">
      {zo.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
    </nav>
  </div>

  <p class="wrap foot-legal">Useful software for real AI work · © 2026</p>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    margin-top: 24px;
    padding: 30px 0 34px;
    color: var(--muted);
    font-size: 14px;
  }
  .foot { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  .foot-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--ink);
  }
  .foot-brand img {
    width: 36px; height: 36px;
    object-fit: contain;
  }
  .foot-links { display: flex; flex-wrap: wrap; gap: 18px; }
  .foot-zo {
    display: flex; align-items: center; flex-wrap: wrap; gap: 8px 16px;
    margin-top: 18px; padding-top: 16px; border-top: 1px dashed var(--line);
  }
  .foot-zo-label {
    font-family: var(--font-mono);
    font-size: 12px; letter-spacing: 0.03em; text-transform: uppercase;
  }
  .foot-zo nav { display: flex; flex-wrap: wrap; gap: 16px; }
  .foot-zo a { color: var(--teal); font-weight: 600; }
  .foot-legal { margin-top: 16px; font-size: 13px; }
  footer a { color: var(--muted); text-decoration: none; }
  footer a:hover { color: var(--ink); text-decoration: underline; }
  .foot-zo a:hover { color: var(--ink); }
</style>
