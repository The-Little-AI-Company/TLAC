---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project">
  <div class="project-copy">
    <span class="eyebrow">{project.status}</span>
    <h3>{project.name}</h3>
    <p class="promise">{project.description}</p>
    <p class="detail">{project.detail}</p>
    <div class="links">
      <a class="btn btn-primary" href={project.productUrl} target="_blank" rel="noopener">
        {project.productLabel} →
      </a>
      <a class="repo" href={project.repositoryUrl} target="_blank" rel="noopener">
        View source
      </a>
    </div>
  </div>
  <img src={project.image} alt="" width="190" height="190" loading="lazy" />
</article>

<style>
  .project {
    display: grid;
    grid-template-columns: 1fr 180px;
    gap: 24px;
    align-items: center;
    min-height: 320px;
    padding: 30px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 4px);
  }
  .project h3 {
    margin-top: 12px;
    font-size: clamp(29px, 3.5vw, 40px);
    font-weight: 900;
  }
  .promise {
    margin-top: 10px;
    max-width: 34ch;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.45;
  }
  .detail {
    margin-top: 10px;
    max-width: 52ch;
    color: var(--muted);
    font-size: 15px;
  }
  .links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 22px;
  }
  .links .btn {
    padding: 10px 16px;
    font-size: 14px;
  }
  .repo {
    color: var(--signal);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }
  .repo:hover { text-decoration: underline; }
  .project img {
    width: 180px;
    height: 180px;
    object-fit: contain;
    filter: drop-shadow(0 10px 16px rgba(33, 29, 23, 0.09));
  }
  @media (max-width: 680px) {
    .project {
      grid-template-columns: 1fr;
      min-height: 0;
      padding: 24px;
    }
    .project img {
      grid-row: 1;
      width: 130px;
      height: 130px;
    }
  }
</style>
