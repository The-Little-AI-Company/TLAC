---
interface Props {
  img: string;
  alt?: string;
  title: string;
  href: string;
  more: string;
}

const { img, alt = '', title, href, more } = Astro.props;
---

<article class="card">
  <img src={img} alt={alt} width="60" height="60" loading="lazy" />
  <div>
    <h3>{title}</h3>
    <p><slot /></p>
    <a class="more" href={href}>{more} →</a>
  </div>
</article>

<style>
  .card {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px;
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(33, 29, 23, 0.07);
    border-color: #E0D4BD;
  }
  .card img { width: 60px; height: 60px; flex: none; }
  .card h3 { font-size: 20px; font-weight: 600; margin-bottom: 5px; }
  .card p { color: var(--muted); font-size: 14.5px; }
  .more {
    display: inline-block;
    margin-top: 10px;
    color: var(--signal);
    font-weight: 600;
    font-size: 13.5px;
    text-decoration: none;
  }
  .more:hover { text-decoration: underline; }
</style>
