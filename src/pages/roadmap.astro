---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = await getCollection("projects");
const updates = (await getCollection("updates")).filter(
  (update) => update.data.status === "published",
);
const sortedUpdates = [...updates].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const dateFormatter = new Intl.DateTimeFormat("en", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const roadmapLanes = [
  {
    status: "live",
    label: "Shipped",
    empty: "The shipped lane is waiting for the first live project.",
    summary: "Stable public work that has a usable surface.",
  },
  {
    status: "in-progress",
    label: "Active",
    empty: "No active project is listed right now.",
    summary: "Work currently being shaped into clearer product surfaces.",
  },
  {
    status: "planned",
    label: "Planned",
    empty: "No planned project is listed right now.",
    summary: "Useful AI work that fits the studio lane and has a likely next shape.",
  },
  {
    status: "research",
    label: "Research",
    empty: "No research project is listed right now.",
    summary: "Early exploration that needs more proof before it becomes planned work.",
  },
] as const;
---

<BaseLayout
  title="Roadmap | The Little AI Company"
  description="A public status and trajectory view for The Little AI Company projects."
  canonicalPath="/roadmap/"
>
  <section class="page-section roadmap-page" aria-labelledby="roadmap-title">
    <div class="page-heading">
      <p class="eyebrow">Roadmap</p>
      <h1 id="roadmap-title">TLAC roadmap.</h1>
      <p class="lede">
        A plain status view of what is shipped, active, planned, or still in
        research, with clear current-stage language for each project.
      </p>
    </div>

    <div class="roadmap-grid">
      {
        roadmapLanes.map((lane) => {
          const laneProjects = projects
            .filter((project) => project.data.status === lane.status)
            .sort((a, b) => a.data.title.localeCompare(b.data.title));

          return (
            <section class="roadmap-lane" aria-labelledby={`${lane.status}-title`}>
              <div class="lane-heading">
                <h2 id={`${lane.status}-title`}>{lane.label}</h2>
                <span>{laneProjects.length}</span>
              </div>
              <p>{lane.summary}</p>
              {
                laneProjects.length > 0 ? (
                  <ul>
                    {laneProjects.map((project) => (
                      <li>
                        <a href={`/projects/${project.id}/`}>{project.data.title}</a>
                        <span>{project.data.purpose}</span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="empty-state">{lane.empty}</p>
                )
              }
            </section>
          );
        })
      }
    </div>

    <section class="roadmap-timeline" aria-labelledby="trajectory-title">
      <div class="section-kicker">
        <p class="eyebrow">Trajectory</p>
        <h2 id="trajectory-title">Recent public movement.</h2>
      </div>
      <ol>
        {
          sortedUpdates.map((update) => (
            <li>
              <time datetime={update.data.date.toISOString()}>
                {dateFormatter.format(update.data.date)}
              </time>
              <div>
                <h3>{update.data.title}</h3>
                <p>{update.data.summary}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </section>
</BaseLayout>
