---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projectImages } from "../../site/project-images";
import { statusLabels, statusOrder } from "../../site/projects";

const projects = await getCollection("projects");
const sortedProjects = [...projects].sort((a, b) => {
  const statusDelta =
    statusOrder.indexOf(a.data.status) - statusOrder.indexOf(b.data.status);

  if (statusDelta !== 0) {
    return statusDelta;
  }

  return a.data.title.localeCompare(b.data.title);
});
const galleryProjects = sortedProjects.map((project) => {
  const imageSrc = projectImages[project.data.image.src as keyof typeof projectImages];

  if (!imageSrc) {
    throw new Error(`Missing project image asset: ${project.data.image.src}`);
  }

  return { project, imageSrc };
});
---

<BaseLayout
  title="Project Gallery | The Little AI Company"
  description="A richer comparison and gallery view of The Little AI Company projects."
  canonicalPath="/projects/gallery/"
>
  <section class="page-section project-gallery-page" aria-labelledby="gallery-title">
    <div class="page-heading">
      <p class="eyebrow">Project gallery</p>
      <h1 id="gallery-title">Compare TLAC projects.</h1>
      <p class="lede">
        A media-forward view for comparing project categories, status, current
        links, and what each project is helping sharpen.
      </p>
      <div class="link-row">
        <a class="text-link compact-link" href="/projects/">Back to project index</a>
        <a class="text-link compact-link" href="/roadmap/">View roadmap</a>
      </div>
    </div>

    <section class="comparison-section" aria-labelledby="comparison-title">
      <div>
        <p class="eyebrow">Compare</p>
        <h2 id="comparison-title">Project comparison</h2>
      </div>
      <div class="comparison-scroll">
        <table class="comparison-table">
          <thead>
            <tr>
              <th scope="col">Project</th>
              <th scope="col">Category</th>
              <th scope="col">Status</th>
              <th scope="col">Links</th>
              <th scope="col">Detail</th>
            </tr>
          </thead>
          <tbody>
            {
              galleryProjects.map(({ project }) => (
                <tr>
                  <th scope="row" data-label="Project">{project.data.title}</th>
                  <td data-label="Category">{project.data.category}</td>
                  <td data-label="Status">{statusLabels[project.data.status]}</td>
                  <td data-label="Links">
                    {
                      project.data.links.length > 0 ? (
                        <div class="table-links">
                          {project.data.links.map((link) => (
                            <a href={link.href}>{link.label}</a>
                          ))}
                        </div>
                      ) : (
                        <span>Links pending</span>
                      )
                    }
                  </td>
                  <td data-label="Detail">
                    <a href={`/projects/${project.id}/`}>View project</a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="gallery-section" aria-labelledby="media-title">
      <div class="section-kicker">
        <p class="eyebrow">Gallery</p>
        <h2 id="media-title">Approved project media.</h2>
      </div>
      <div class="gallery-grid">
        {
          galleryProjects.map(({ project, imageSrc }, index) => (
            <article class="gallery-card">
              <figure class="gallery-media">
                <Image
                  src={imageSrc}
                  alt={project.data.image.alt}
                  widths={[360, 560, 760, 960]}
                  sizes="(max-width: 820px) calc(100vw - 64px), 500px"
                  format="webp"
                  quality={78}
                  loading={index < 2 ? "eager" : "lazy"}
                  decoding="async"
                />
              </figure>
              <div class="project-meta">
                <span>{project.data.category}</span>
                <span>{statusLabels[project.data.status]}</span>
              </div>
              <h3>{project.data.title}</h3>
              <p>{project.data.leveledUp}</p>
              <a class="text-link compact-link" href={`/projects/${project.id}/`}>
                View project
              </a>
            </article>
          ))
        }
      </div>
    </section>
  </section>
</BaseLayout>
