---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { statusLabels, statusOrder } from "../../site/projects";

const projects = await getCollection("projects");
const sortedProjects = [...projects].sort((a, b) => {
  const statusDelta =
    statusOrder.indexOf(a.data.status) - statusOrder.indexOf(b.data.status);

  if (statusDelta !== 0) {
    return statusDelta;
  }

  return a.data.title.localeCompare(b.data.title);
});

const categories = [...new Set(sortedProjects.map((project) => project.data.category))].sort();
const statuses = statusOrder
  .map((status) => ({
    status,
    label: statusLabels[status],
    count: sortedProjects.filter((project) => project.data.status === status).length,
  }))
  .filter((item) => item.count > 0);
---

<BaseLayout
  title="Projects | The Little AI Company"
  description="A scan-friendly index of The Little AI Company projects by status, category, and purpose."
>
  <section class="page-section projects-page" aria-labelledby="projects-title">
    <div class="page-heading">
      <p class="eyebrow">Projects</p>
      <h1 id="projects-title">Useful AI work, easy to scan.</h1>
      <p class="lede">
        A compact view of the current TLAC project set: what each project is for,
        where it stands, and what it is helping sharpen.
      </p>
    </div>

    <div class="index-toolbar" aria-label="Project filters and counts">
      <div>
        <strong>Status</strong>
        <div class="chip-row">
          {
            statuses.map((item) => (
              <a class="chip" href={`#status-${item.status}`}>
                {item.label}
                <span>{item.count}</span>
              </a>
            ))
          }
        </div>
      </div>
      <div>
        <strong>Categories</strong>
        <div class="chip-row">
          {
            categories.map((category) => (
              <span class="chip">{category}</span>
            ))
          }
        </div>
      </div>
    </div>

    {
      statuses.map((group) => {
        const groupedProjects = sortedProjects.filter(
          (project) => project.data.status === group.status,
        );

        return (
          <section
            id={`status-${group.status}`}
            class="project-group"
            aria-labelledby={`status-${group.status}-title`}
          >
            <div class="group-heading">
              <h2 id={`status-${group.status}-title`}>{group.label}</h2>
              <span>{group.count} projects</span>
            </div>
            <div class="project-grid">
              {groupedProjects.map((project) => (
                <article class="project-index-card" data-project-card>
                  <div class="project-meta">
                    <span>{project.data.category}</span>
                    <span>{project.data.year}</span>
                  </div>
                  <h3>{project.data.title}</h3>
                  <p>{project.data.purpose}</p>
                  <p>{project.data.leveledUp}</p>
                  <div class="project-footer">
                    <div class="swatches" aria-hidden="true">
                      {project.data.palette.map((color) => (
                        <span class={color}></span>
                      ))}
                    </div>
                    {
                      project.data.links.length > 0 && (
                        <div class="project-links">
                          {project.data.links.map((link) => (
                            <a href={link.href}>{link.label}</a>
                          ))}
                        </div>
                      )}
                  </div>
                </article>
              ))}
            </div>
          </section>
        );
      })
    }
  </section>
</BaseLayout>
