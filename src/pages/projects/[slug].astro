---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { canonicalUrl } from "../../site/metadata";
import { statusLabels } from "../../site/projects";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const projectData = project.data;
const imageModules = import.meta.glob("../../../assets/brand/**/*.png", {
  eager: true,
  import: "default",
  query: "?url",
});
const imageSrc = imageModules[`../../../${projectData.image.src}`] as string | undefined;

if (!imageSrc) {
  throw new Error(`Missing project image asset: ${projectData.image.src}`);
}

const projectPath = `/projects/${project.id}/`;
const projectType =
  /tool|app|workspace|studio/i.test(projectData.category) ? "SoftwareApplication" : "CreativeWork";
const projectJsonLd = {
  "@type": projectType,
  "@id": `${canonicalUrl(projectPath)}#project`,
  name: projectData.title,
  url: canonicalUrl(projectPath),
  description: projectData.purpose,
  creator: { "@id": canonicalUrl("/#organization") },
  publisher: { "@id": canonicalUrl("/#organization") },
  dateCreated: String(projectData.year),
  image: canonicalUrl(imageSrc),
  ...(projectType === "SoftwareApplication"
    ? {
        applicationCategory: projectData.category,
        operatingSystem: "Web",
      }
    : {}),
};
---

<BaseLayout
  title={`${projectData.title} | The Little AI Company`}
  description={projectData.purpose}
  canonicalPath={projectPath}
  jsonLd={projectJsonLd}
>
  <article class="page-section project-detail" aria-labelledby="project-title">
    <a class="text-link" href="/projects/">Back to projects</a>

    <header class="project-detail-hero">
      <div>
        <p class="eyebrow">{projectData.category}</p>
        <h1 id="project-title">{projectData.title}</h1>
        <p class="lede">{projectData.purpose}</p>
        <div class="detail-meta" aria-label="Project facts">
          <span>{projectData.year}</span>
          <span>{statusLabels[projectData.status]}</span>
        </div>
      </div>
      <figure class="detail-media">
        <img src={imageSrc} alt={projectData.image.alt} loading="eager" />
      </figure>
    </header>

    <div class="detail-grid">
      <section class="detail-section" aria-labelledby="why-title">
        <h2 id="why-title">Why It Exists</h2>
        <p>{projectData.why}</p>
      </section>

      <section class="detail-section" aria-labelledby="status-title">
        <h2 id="status-title">Current Status</h2>
        <p>{statusLabels[projectData.status]}</p>
      </section>

      <section class="detail-section" aria-labelledby="links-title">
        <h2 id="links-title">Project Links</h2>
        {
          projectData.links.length > 0 ? (
            <ul class="detail-links">
              {projectData.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          ) : (
            <p>Public links will be added when this project has a stable surface to visit.</p>
          )
        }
      </section>

      <section class="detail-section" aria-labelledby="leveled-up-title">
        <h2 id="leveled-up-title">What Leveled Up</h2>
        <p>{projectData.leveledUp}</p>
      </section>

      {
        projectData.caveats.length > 0 && (
          <section class="detail-section" aria-labelledby="caveats-title">
            <h2 id="caveats-title">Caveats</h2>
            <ul>
              {projectData.caveats.map((caveat) => (
                <li>{caveat}</li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <section class="detail-section project-body" aria-label={`${projectData.title} notes`}>
      <Content />
    </section>
  </article>
</BaseLayout>
