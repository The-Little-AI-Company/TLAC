---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);

const sections = [
  {
    title: 'Learn and get help',
    description: 'Build practical AI skills or work with us directly.',
    links: [
      { href: '/start-here', label: 'Start here', description: 'A short route into the free AI Starter Kit.' },
      { href: '/guides', label: 'All guides', description: 'The complete beginner-first Starter Kit.' },
      { href: '/services', label: 'Work with us', description: 'Practical workshops, agent coaching, and workflow design.' },
    ],
  },
  {
    title: 'Tools',
    description: 'Inspectable software that supports reliable AI work.',
    links: [
      { href: '/projects', label: 'Projects', description: 'Vivary, Agent Relay, Bellamente, and related open work.' },
    ],
  },
  {
    title: 'Company',
    description: 'Who we are, how to reach us, and the character behind the workbench.',
    links: [
      { href: '/about', label: 'About', description: 'Our education-first mission and working principles.' },
      { href: '/club', label: 'Club', description: 'Learn and build in public with the company.' },
      { href: '/brand', label: 'The owl', description: 'Meet Hoolio and browse the reusable illustration system.' },
      { href: '/contact', label: 'Contact', description: 'Questions, collaborations, and project inquiries.' },
    ],
  },
];
---

<BaseLayout
  title="All pages — The Little AI Company"
  description="A complete directory of The Little AI Company website: products, services, guides, company pages, and brand resources."
>
  <section class="directory-hero">
    <span class="eyebrow">// everything on the site</span>
    <h1>All pages</h1>
    <p class="lede">
      The primary navigation stays small. This directory does not. Every public
      page on the site has a home here.
    </p>
    <a class="home-link" href="/">← Home</a>
  </section>

  <div class="directory-sections">
    {sections.map((section) => (
      <section class="directory-section">
        <header>
          <h2>{section.title}</h2>
          <p>{section.description}</p>
        </header>
        <div class="link-grid">
          {section.links.map((link) => (
            <a class="page-link" href={link.href}>
              <span>{link.label}</span>
              <p>{link.description}</p>
              <b aria-hidden="true">→</b>
            </a>
          ))}
        </div>
      </section>
    ))}

    <section class="directory-section">
      <header>
        <h2>Individual guides</h2>
        <p>Go directly to any guide without stepping through the Starter Kit first.</p>
      </header>
      <div class="guide-grid">
        {guides.map((guide) => (
          <a class="guide-link" href={`/guides/${guide.id}`}>
            <span class="eyebrow">{guide.data.pillar}</span>
            <strong>{guide.data.title}</strong>
            <b aria-hidden="true">→</b>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .directory-hero {
    max-width: 760px;
    padding: 64px 0 44px;
  }
  .directory-hero h1 {
    margin-top: 14px;
    font-size: clamp(44px, 6vw, 68px);
    font-weight: 900;
  }
  .lede {
    max-width: 58ch;
    margin-top: 16px;
    color: var(--muted);
    font-size: 18px;
  }
  .home-link {
    display: inline-block;
    margin-top: 20px;
    color: var(--signal);
    font-weight: 700;
    text-decoration: none;
  }
  .home-link:hover { text-decoration: underline; }
  .directory-sections {
    display: grid;
    gap: 48px;
    padding-bottom: 36px;
  }
  .directory-section {
    padding-top: 30px;
    border-top: 1px solid var(--line);
  }
  .directory-section > header {
    display: grid;
    grid-template-columns: minmax(220px, 0.6fr) 1fr;
    gap: 24px;
    align-items: end;
    margin-bottom: 20px;
  }
  .directory-section h2 {
    font-size: 28px;
    font-weight: 600;
  }
  .directory-section > header p {
    color: var(--muted);
  }
  .link-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .page-link,
  .guide-link {
    position: relative;
    display: block;
    padding: 20px 50px 20px 20px;
    color: inherit;
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s;
  }
  .page-link:hover,
  .guide-link:hover {
    transform: translateY(-2px);
    border-color: #d8c9ad;
    box-shadow: 0 10px 24px rgba(33, 29, 23, 0.06);
  }
  .page-link > span {
    font-family: var(--font-head);
    font-size: 21px;
    font-weight: 700;
  }
  .page-link p {
    margin-top: 6px;
    color: var(--muted);
    font-size: 14px;
  }
  .page-link b,
  .guide-link b {
    position: absolute;
    top: 20px;
    right: 20px;
    color: var(--signal);
  }
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .guide-link .eyebrow {
    display: block;
    margin-bottom: 7px;
    color: var(--signal);
  }
  .guide-link strong {
    font-family: var(--font-head);
    font-size: 18px;
  }
  @media (max-width: 700px) {
    .directory-section > header,
    .link-grid,
    .guide-grid {
      grid-template-columns: 1fr;
    }
    .directory-section > header { gap: 6px; }
  }
</style>
