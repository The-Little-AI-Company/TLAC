---
import BaseLayout from '../layouts/BaseLayout.astro';
import Signup from '../components/Signup.astro';

const ladder = [
  {
    tag: 'By request',
    title: 'Workflow and tool design',
    body: 'Turn a recurring AI-assisted job into a workflow with clear inputs, limits, stop points, and receipts.',
    cta: 'Talk about the work',
    href: '/contact',
    live: true,
  },
  {
    tag: 'By request',
    title: 'Product implementation',
    body: 'Focused help prototyping or shipping a small, practical AI product without hiding the hard parts behind a demo.',
    cta: 'Talk about a product',
    href: '/contact',
    live: false,
  },
  {
    tag: 'Workshops',
    title: 'Practical AI education',
    body: 'Plain-English, build-along learning for teams that want useful capability and better judgment — not another tool tour.',
    cta: 'Ask about a workshop',
    href: '/contact',
    live: false,
  },
  {
    tag: 'Free · available now',
    title: 'The AI Starter Kit',
    body: 'Seven plain-English guides for making something useful, checking AI output, and protecting private information.',
    cta: 'Use the free guides',
    href: '/guides',
    live: false,
  },
];
---

<BaseLayout
  title="Work with us — The Little AI Company"
  description="Focused product, workflow, and practical AI education work from The Little AI Company."
>
  <section class="svc-hero">
    <span class="eyebrow">// work with us</span>
    <h1>Need help making the useful thing real?</h1>
    <p class="lede">
      The products come first. We also take on focused work where our way of building
      is a fit: small scope, real users, visible limits, and evidence that it works.
    </p>
  </section>

  <div class="ladder">
    {ladder.map((r) => (
      <article class="rung">
        <span class="eyebrow tag">{r.tag}</span>
        <h2>{r.title}</h2>
        <p>{r.body}</p>
        <a class:list={['more', { live: r.live }]} href={r.href}>{r.cta} →</a>
      </article>
    ))}
  </div>

  <section id="list" class="list">
    <h2>Follow what we ship.</h2>
    <p>New releases, build notes, and the occasional useful guide — sent when there is something worth showing.</p>
    <Signup source="services-early-list" subject="TLAC build notes signup" cta="Keep me posted" />
    <small class="hint">No spam. No fake urgency.</small>
  </section>
</BaseLayout>

<style>
  .svc-hero { max-width: 720px; padding: 56px 0 26px; }
  .svc-hero h1 { font-size: clamp(34px, 5.2vw, 56px); font-weight: 900; margin: 16px 0 0; }
  .lede { color: var(--muted); font-size: 18.5px; margin: 18px 0 0; max-width: 60ch; }

  .ladder { display: grid; gap: 14px; padding: 8px 0 30px; }
  .rung {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 22px 24px;
  }
  .rung .tag { color: var(--signal); }
  .rung h2 { font-size: 22px; font-weight: 600; margin: 8px 0 6px; }
  .rung p { color: var(--muted); font-size: 15.5px; max-width: 70ch; }
  .more { display: inline-block; margin-top: 12px; color: var(--muted); font-weight: 600; font-size: 14px; text-decoration: none; }
  .more.live { color: var(--signal); }
  .more:hover { text-decoration: underline; }

  .list {
    margin-top: 18px; padding: 28px 24px; border: 1px solid var(--line);
    border-radius: var(--radius); background: var(--paper);
  }
  .list h2 { font-size: 24px; font-weight: 600; }
  .list p { color: var(--muted); margin: 8px 0 16px; max-width: 60ch; }
  .hint { display: block; margin-top: 10px; color: var(--muted); font-size: 13px; }
</style>
