---
import BaseLayout from '../layouts/BaseLayout.astro';
import Signup from '../components/Signup.astro';

const ladder = [
  {
    tag: 'Workshops',
    title: 'Practical AI workshops',
    body: 'Plain-English, build-along sessions that help non-technical people use AI with more confidence, judgment, and control.',
    cta: 'Ask about a workshop',
    href: '/contact',
  },
  {
    tag: 'By request',
    title: 'AI workflow and agent coaching',
    body: 'Hands-on help turning a recurring job into a reliable workflow with clear inputs, verification, limits, and human decisions.',
    cta: 'Talk about your workflow',
    href: '/contact',
  },
  {
    tag: 'Focused builds',
    title: 'Workflow and tool design',
    body: 'When software is the useful answer, we prototype focused tools that make AI-assisted work easier to understand and verify.',
    cta: 'Talk about a tool',
    href: '/contact',
  },
  {
    tag: 'Free · available now',
    title: 'The AI Starter Kit',
    body: 'Seven plain-English guides for making something useful, checking AI output, and protecting private information.',
    cta: 'Use the free guides',
    href: '/guides',
  },
];
---

<BaseLayout
  title="Work with us — The Little AI Company"
  description="Practical AI workshops, agent coaching, and focused workflow design for non-technical people and teams."
>
  <section class="svc-hero">
    <span class="eyebrow">// work with us</span>
    <h1>Build real AI capability — not just another pile of tools.</h1>
    <p class="lede">
      We teach people how to work with AI and AI agents through practical workshops,
      coaching, and hands-on workflow design. When software helps, we build it with
      visible limits and evidence that it works.
    </p>
  </section>

  <div class="ladder">
    {ladder.map((r) => (
      <article class="rung">
        <span class="eyebrow tag">{r.tag}</span>
        <h2>{r.title}</h2>
        <p>{r.body}</p>
        <a class="more" href={r.href}>{r.cta} →</a>
      </article>
    ))}
  </div>

  <section id="list" class="list">
    <h2>Follow what we teach and build.</h2>
    <p>Useful guides, workshop lessons, new tools, and honest build notes — sent when there is something worth sharing.</p>
    <Signup source="services-early-list" subject="TLAC build notes signup" cta="Keep me posted" />
    <small class="hint">No spam. No fake urgency.</small>
  </section>
</BaseLayout>

<style>
  .svc-hero { max-width: 720px; padding: 56px 0 26px; }
  .svc-hero h1 { font-size: clamp(34px, 5.2vw, 56px); font-weight: 900; margin: 16px 0 0; }
  .lede { color: var(--muted); font-size: 18.5px; margin: 18px 0 0; max-width: 60ch; }

  .ladder { display: grid; gap: 14px; padding: 8px 0 30px; }
  .rung {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 22px 24px;
  }
  .rung .tag { color: var(--signal); }
  .rung h2 { font-size: 22px; font-weight: 600; margin: 8px 0 6px; }
  .rung p { color: var(--muted); font-size: 15.5px; max-width: 70ch; }
  .more { display: inline-block; margin-top: 12px; color: var(--signal); font-weight: 600; font-size: 14px; text-decoration: none; }
  .more:hover { text-decoration: underline; }

  .list {
    margin-top: 18px; padding: 28px 24px; border: 1px solid var(--line);
    border-radius: var(--radius); background: var(--paper);
  }
  .list h2 { font-size: 24px; font-weight: 600; }
  .list p { color: var(--muted); margin: 8px 0 16px; max-width: 60ch; }
  .hint { display: block; margin-top: 10px; color: var(--muted); font-size: 13px; }
</style>
