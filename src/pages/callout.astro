---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Lane from '../components/Lane.astro';
import Lanes from '../components/Lanes.astro';
import SpecPlate from '../components/SpecPlate.astro';
import SplitSection from '../components/SplitSection.astro';
import ToolHero from '../components/ToolHero.astro';
import { callout, calloutPlate, latestVersion } from '../data/tools';

const version = await latestVersion(callout.version);
---

<Base
  title="Callout"
  description="Press a hotkey over any text. Callout says whether it is trying to manipulate you and whether its claims hold up. Windows, bring your own keys, no server."
>
  <ToolHero tool={callout}>
    <SpecPlate {...calloutPlate(version)} />
  </ToolHero>

  <SplitSection heading="What it does">
    <p slot="intro" class="text">
      Select text anywhere on Windows, press the hotkey, and a small popover answers
      two questions.
    </p>
    <Lanes>
      <Lane term="Fast lane, under a second">
        Is this text trying to manipulate you? Callout scores the passage against a
        battery of manipulation signals, such as false urgency, loaded framing, and
        appeals that stand in for evidence.
      </Lane>
      <Lane term={'Deep lane, a\u00a0few seconds'}>
        Do the specific claims hold up? Callout pulls out the checkable claims, looks
        first at the sources the text cites, then searches the web, and shows you
        what it found. Nothing is shown without a source. Unsure is a real answer.
      </Lane>
    </Lanes>
  </SplitSection>

  <SplitSection heading="How it works">
    <p slot="intro" class="text">
      Three parts with one rule between them. The model that judges never writes
      prose, and the model that writes prose never judges.
    </p>
    <Lanes>
      <Lane term="A judging model">
        Returns probabilities, never sentences. It scores what kind of content this
        is, the manipulation signals in it, whether a passage is relevant, whether
        evidence supports a claim, and every sentence the helper writes.
      </Lane>
      <Lane term="A writing helper">
        Any OpenAI-compatible or Anthropic endpoint. It extracts claims, drafts search
        queries, reads screenshots, and writes the two-sentence summary. Everything it
        writes goes back through the judge.
      </Lane>
      <Lane term="A rules file">
        Every threshold, cap, and question lives in one readable file in the
        repository. Nothing is tuned behind a server.
      </Lane>
    </Lanes>
  </SplitSection>

  <SplitSection heading="What stays on your machine">
    <Lanes>
      <Lane term="No server">
        No account, no telemetry. The text you check goes to the three
        APIs you configure and to the pages Callout fetches for evidence, and nowhere
        else.
      </Lane>
      <Lane term="Your keys">
        You bring your own API keys. They sit in Windows Credential Manager, never in
        a plain-text file.
      </Lane>
      <Lane term="Your history">Off by default. Usage counters stay local.</Lane>
    </Lanes>
  </SplitSection>

  <SplitSection id="get-it" heading="Get it">
    <p class="lede">
      Download the installer for Windows 10 and 11, run it, and paste your API keys
      into Settings. No account. Open source under MIT.
    </p>
    <div class="actions">
      <Button href={callout.primary.href} variant="primary">{callout.primary.label}</Button>
    </div>
    <p class="text-sm note">
      The installer is unsigned for now, so Windows SmartScreen warns on first run.
      Choose More info, then Run anyway. The source is on GitHub if you’d rather
      build it yourself.
    </p>
  </SplitSection>
</Base>

<style>
  .note {
    margin-top: var(--space-4);
    color: var(--ink-faint);
  }
</style>
