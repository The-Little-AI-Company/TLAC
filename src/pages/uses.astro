---
import BaseLayout from "../layouts/BaseLayout.astro";

const useGroups = [
  {
    id: "project-memory",
    title: "Project memory",
    items: [
      {
        name: "Vivary",
        purpose: "Keeps the roadmap, verification notes, and long-running project context visible.",
      },
      {
        name: "GitHub Issues and PRs",
        purpose: "Turns work into small reviewed slices with a visible backlog.",
      },
      {
        name: "Markdown docs",
        purpose: "Keeps product decisions, gates, and handoff notes close to the code.",
      },
    ],
  },
  {
    id: "build-surface",
    title: "Build surface",
    items: [
      {
        name: "Astro",
        purpose: "Ships a fast static site with structured content and clean generated routes.",
      },
      {
        name: "Plain CSS",
        purpose: "Keeps the interface inspectable, responsive, and light.",
      },
      {
        name: "Cloudflare Pages",
        purpose: "The planned static hosting target once publishing is approved.",
      },
    ],
  },
  {
    id: "verification",
    title: "Verification",
    items: [
      {
        name: "Route smoke",
        purpose: "Checks the public pages and crawler surfaces after each build.",
      },
      {
        name: "Accessibility smoke",
        purpose: "Checks headings, skip links, alt text, link names, focus hooks, contrast, and wrapping.",
      },
      {
        name: "Performance smoke",
        purpose: "Keeps production images intentional and small.",
      },
    ],
  },
  {
    id: "ai-assisted-making",
    title: "AI-assisted making",
    items: [
      {
        name: "Agent coding sessions",
        purpose: "Plan, implement, test, review, fix, and merge one issue at a time.",
      },
      {
        name: "Structured prompts",
        purpose: "Make AI collaboration repeatable enough to teach and improve.",
      },
      {
        name: "Human review gates",
        purpose: "Keep publishing, private context, and product claims deliberate.",
      },
    ],
  },
];
---

<BaseLayout
  title="Uses | The Little AI Company"
  description="A short TLAC-specific uses page for the tools and checks behind this one-person AI studio."
  canonicalPath="/uses/"
>
  <section class="page-section uses-page" aria-labelledby="uses-title">
    <div class="page-heading">
      <p class="eyebrow">Uses</p>
      <h1 id="uses-title">The TLAC working kit.</h1>
      <p class="lede">
        A short list of the tools and practices that help The Little AI Company
        plan, build, verify, and explain useful AI work.
      </p>
    </div>

    <div class="uses-note">
      <strong>Kept intentionally small</strong>
      <p>
        This page stays focused on the small working kit behind TLAC projects:
        planning, building, verifying, and explaining useful AI work.
      </p>
    </div>

    <div class="uses-grid">
      {
        useGroups.map((group) => (
          <section class="uses-section" aria-labelledby={`${group.id}-title`}>
            <h2 id={`${group.id}-title`}>{group.title}</h2>
            <ul>
              {group.items.map((item) => (
                <li>
                  <strong>{item.name}</strong>
                  <span>{item.purpose}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
