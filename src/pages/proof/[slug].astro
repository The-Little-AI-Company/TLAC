---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const proofs = (await getCollection("proofs")).filter(
    (proof) => proof.data.status === "published",
  );

  return proofs.map((proof) => ({
    params: { slug: proof.id },
    props: { proof },
  }));
}

const { proof } = Astro.props;
const { Content } = await render(proof);
const projects = await getCollection("projects");
const relatedProject = projects.find((project) => project.id === proof.data.project);
const dateFormatter = new Intl.DateTimeFormat("en", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const proofSteps = [
  { label: "Problem", body: proof.data.problem },
  { label: "Build", body: proof.data.build },
  { label: "Proof", body: proof.data.proof },
  { label: "Lesson", body: proof.data.lesson },
  { label: "Next step", body: proof.data.nextStep },
];
---

<BaseLayout
  title={`${proof.data.title} | The Little AI Company`}
  description={proof.data.summary}
  canonicalPath={`/proof/${proof.id}/`}
>
  <article class="page-section proof-detail-page" aria-labelledby="proof-detail-title">
    <a class="text-link" href="/proof/">Back to proof</a>

    <header class="proof-detail-hero">
      <div>
        <p class="eyebrow">Proof note</p>
        <h1 id="proof-detail-title">{proof.data.title}</h1>
        <p class="lede">{proof.data.summary}</p>
      </div>
      <div class="proof-facts" aria-label="Proof facts">
        <div>
          <strong>Project</strong>
          {
            relatedProject ? (
              <a href={`/projects/${relatedProject.id}/`}>{relatedProject.data.title}</a>
            ) : (
              <span>{proof.data.project}</span>
            )
          }
        </div>
        <div>
          <strong>Date</strong>
          <time datetime={proof.data.date.toISOString()}>
            {dateFormatter.format(proof.data.date)}
          </time>
        </div>
      </div>
    </header>

    <div class="proof-detail-grid">
      {
        proofSteps.map((step) => (
          <section class="proof-panel" aria-labelledby={`${step.label.toLowerCase().replaceAll(" ", "-")}-title`}>
            <h2 id={`${step.label.toLowerCase().replaceAll(" ", "-")}-title`}>{step.label}</h2>
            <p>{step.body}</p>
          </section>
        ))
      }
    </div>

    <section class="proof-panel proof-caveats" aria-labelledby="honest-caveats-title">
      <h2 id="honest-caveats-title">Honest caveats</h2>
      <ul>
        {proof.data.caveats.map((caveat) => <li>{caveat}</li>)}
      </ul>
    </section>

    {
      proof.data.links.length > 0 && (
        <section class="proof-panel" aria-labelledby="proof-links-title">
          <h2 id="proof-links-title">Related links</h2>
          <ul class="detail-links">
            {proof.data.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="proof-panel proof-body" aria-label={`${proof.data.title} notes`}>
      <Content />
    </section>
  </article>
</BaseLayout>
