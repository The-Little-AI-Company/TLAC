---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const proofs = (await getCollection("proofs")).filter(
  (proof) => proof.data.status === "published",
);
const projects = await getCollection("projects");
const projectsById = new Map(projects.map((project) => [project.id, project]));
const sortedProofs = [...proofs].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const dateFormatter = new Intl.DateTimeFormat("en", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  title="Proof | The Little AI Company"
  description="Practical proof notes and case-study patterns from The Little AI Company."
  canonicalPath="/proof/"
>
  <section class="page-section proof-index-page" aria-labelledby="proof-title">
    <div class="page-heading">
      <p class="eyebrow">Proof</p>
      <h1 id="proof-title">Practical proof, kept honest.</h1>
      <p class="lede">
        Short case-study notes that show the problem, build, proof, lesson,
        caveats, and next step behind TLAC work.
      </p>
    </div>

    <div class="proof-list">
      {
        sortedProofs.map((proof) => {
          const project = projectsById.get(proof.data.project);

          return (
            <article class="proof-index-card">
              <div class="project-meta">
                <span>{project?.data.title ?? proof.data.project}</span>
                <time datetime={proof.data.date.toISOString()}>
                  {dateFormatter.format(proof.data.date)}
                </time>
              </div>
              <h2>{proof.data.title}</h2>
              <p>{proof.data.summary}</p>
              <a class="text-link compact-link" href={`/proof/${proof.id}/`}>
                Read proof
              </a>
            </article>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
