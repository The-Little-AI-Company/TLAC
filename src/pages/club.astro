---
import BaseLayout from '../layouts/BaseLayout.astro';

const pillars = [
  'The full prompt & workflow library — copy, tweak, reuse.',
  'A printable visual library — posters, diagrams, cheat-sheets.',
  'Build-alongs & practice — small useful projects, not theory.',
  'Workshop replays — watch the thinking, not just the result.',
  'Learning paths — a clear track from beginner to capable.',
  'Office hours & Q&A — get unstuck with real help.',
];
---

<BaseLayout
  title="The Club — The Little AI Company"
  description="The membership for people who want to go deeper: the full library, build-alongs, workshops, learning paths, and office hours."
>
  <section class="club-hero">
    <span class="eyebrow">// the little ai club</span>
    <h1>Go deeper, together.</h1>
    <p class="lede">
      The free Starter Kit gets you your first wins. The Club is where you build the habit —
      the full library, hands-on practice, workshops, and support, organized as a path from
      beginner to genuinely capable.
    </p>
    <a class="btn btn-primary" href="#waitlist">Join the waitlist →</a>
  </section>

  <h2 class="ph">What members get</h2>
  <ul class="pillars">
    {pillars.map((p) => <li>{p}</li>)}
  </ul>

  <section id="waitlist" class="waitlist">
    <h2>Be a founding member.</h2>
    <p>
      We're opening the Club with a small group of early members who'll help shape it — and
      lock in founding-member perks. There's no price yet; join the list and you'll be the
      first to know when the doors open.
    </p>
    <form class="capture" method="post" action="#" aria-label="Join the Club waitlist">
      <label class="visually-hidden" for="email">Email address</label>
      <input id="email" type="email" name="email" placeholder="you@email.com" required />
      <button type="submit">Join the waitlist</button>
    </form>
    <small class="hint">No spam. Just one note when the doors open.</small>
  </section>
</BaseLayout>

<style>
  .club-hero { max-width: 720px; padding: 56px 0 26px; }
  .club-hero h1 { font-size: clamp(34px, 5.2vw, 56px); font-weight: 900; margin: 16px 0 0; }
  .lede { color: var(--muted); font-size: 18.5px; margin: 18px 0 24px; max-width: 58ch; }
  .ph { font-size: 26px; font-weight: 600; margin: 18px 0 14px; }
  .pillars { list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; padding-bottom: 12px; }
  .pillars li {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 15px 17px; font-size: 15.5px;
  }
  .waitlist {
    margin-top: 26px; padding: 28px 24px; border: 1px solid var(--line);
    border-radius: var(--radius); background: var(--paper);
  }
  .waitlist h2 { font-size: 24px; font-weight: 600; }
  .waitlist p { color: var(--muted); margin: 8px 0 16px; max-width: 60ch; }
  .capture { display: flex; gap: 8px; max-width: 440px; }
  .capture input {
    flex: 1; padding: 11px 13px; border: 1px solid var(--line);
    border-radius: 8px; font: inherit; background: var(--surface);
  }
  .capture button {
    padding: 11px 16px; border: 0; border-radius: 8px;
    background: var(--teal); color: #04201f; font-weight: 700; cursor: pointer;
  }
  .hint { display: block; margin-top: 8px; color: var(--muted); font-size: 13px; }
  @media (max-width: 640px) { .pillars { grid-template-columns: 1fr; } }
</style>
