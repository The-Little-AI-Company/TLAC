---
import BaseLayout from '../layouts/BaseLayout.astro';
import Signup from '../components/Signup.astro';
---

<BaseLayout
  title="The Club — The Little AI Company"
  description="Follow The Little AI Company as we learn, teach, and build better ways for ordinary people to use AI."
>
  <section class="club-hero">
    <span class="eyebrow">// the little ai club</span>
    <h1>Learn in public with us.</h1>
    <p class="lede">
      We are building a useful community around practical AI skills, honest experiments,
      and tools that help people work with agents more reliably. There is no paid
      membership to pitch yet — just real lessons and work worth following.
    </p>
    <a class="btn btn-primary" href="/start-here">Start learning →</a>
  </section>

  <section id="waitlist" class="waitlist">
    <h2>Follow the learning and the workshop.</h2>
    <p>
      Get practical guides, workshop lessons, honest build notes, and new tools. If a
      deeper community grows around the work, the people learning with us will hear first.
    </p>
    <Signup source="club-waitlist" subject="TLAC build notes signup" cta="Keep me posted" />
    <small class="hint">No spam. No fake countdown.</small>
  </section>
</BaseLayout>

<style>
  .club-hero { max-width: 720px; padding: 56px 0 26px; }
  .club-hero h1 { font-size: clamp(34px, 5.2vw, 56px); font-weight: 900; margin: 16px 0 0; }
  .lede { color: var(--muted); font-size: 18.5px; margin: 18px 0 24px; max-width: 58ch; }
  .waitlist {
    margin-top: 26px; padding: 28px 24px; border: 1px solid var(--line);
    border-radius: var(--radius); background: var(--paper);
  }
  .waitlist h2 { font-size: 24px; font-weight: 600; }
  .waitlist p { color: var(--muted); margin: 8px 0 16px; max-width: 60ch; }
  .hint { display: block; margin-top: 10px; color: var(--muted); font-size: 13px; }
</style>
