---
import Base from '../layouts/Base.astro';
import Lane from '../components/Lane.astro';
import Lanes from '../components/Lanes.astro';
import Plate from '../components/Plate.astro';
import SplitSection from '../components/SplitSection.astro';
import ToolHero from '../components/ToolHero.astro';
import { vivary } from '../data/tools';

const releases = `${vivary.repo}/releases`;
---

<Base
  title="Vivary"
  description="A desktop workspace for AI agents on your own projects. Agent chat, project files, tools, and memory in one app. Windows first. Files stay where you run them."
>
  <ToolHero tool={vivary}>
    <Plate
      src="/images/vivary-site-2026-10-08.webp"
      srcset="/images/vivary-site-2026-10-08-640.webp 640w, /images/vivary-site-2026-10-08.webp 1200w"
      alt="The vivaryagent.xyz home page: the headline “Your projects. Your AI agents.”, a Windows preview download button, and the felt antlered mascot holding a book."
      width={1200}
      height={750}
      eager
    >
      <Fragment slot="caption">vivaryagent.xyz, Oct 8, 2026.</Fragment>
    </Plate>
  </ToolHero>

  <SplitSection heading="What it is">
    <p slot="intro" class="text">
      One app where you open a project, talk to an agent about it, and watch what
      the agent does to your files. The agents, your credentials, your files, and
      the conversation history stay on the machine that runs Vivary.
    </p>
    <Lanes>
      <Lane term="Work on a project">
        Open a project and work with an agent that can read files, edit them, and run
        tools. Every change lands in your own folder.
      </Lane>
      <Lane term="Come back to it">
        Return to a project’s conversations, search past sessions, and keep the
        memory worth keeping in files you can open.
      </Lane>
      <Lane term="Use the harnesses you have">
        Supported coding harnesses you already installed, such as Claude Code, run
        inside the workspace with their own tools. Guidance for them lives in files
        in the project.
      </Lane>
      <Lane term="See what you’re building">
        Preview the site or dashboard the agent is working on, and let the agent
        inspect and debug it.
      </Lane>
      <Lane term="Reach it from your phone">
        Run it on your computer or on a server of your own. Connect a phone browser
        only when you turn on remote access.
      </Lane>
    </Lanes>
  </SplitSection>

  <SplitSection heading="What it asks of you">
    <Lanes>
      <Lane term="No Vivary account">
        Local desktop use needs none. Your provider accounts are yours and separate.
      </Lane>
      <Lane term="Remote access is opt-in">Off until you set it up, and authenticated when it’s on.</Lane>
      <Lane term="Windows first">
        The desktop app targets Windows. A Mac build is possible later work, not a promise.
      </Lane>
    </Lanes>
  </SplitSection>

  <SplitSection heading="Status">
    <p class="lede">
      In development. A Windows preview came out on Sept 22, 2026 as a <a class="nowrap" href={releases}>pre-release</a>:
      an unsigned portable ZIP, not a stable release. The <a class="nowrap" href={vivary.queue}>release queue</a> lists
      what is verified and what is still required, in the open. Open source under MIT.
    </p>
    <p class="text-sm original">
      The original Vivary command-line tools, which scaffold typed memory for agent
      workspaces, are preserved as <a href="https://www.npmjs.com/package/@vivary/create">@vivary/create</a> on npm and <a href="https://pypi.org/project/create-vivary/">create-vivary</a> on PyPI. They are not the desktop app.
    </p>
  </SplitSection>
</Base>

<style>
  .original {
    margin-top: var(--space-5);
    color: var(--ink-faint);
  }
</style>
