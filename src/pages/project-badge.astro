---
import BaseLayout from "../layouts/BaseLayout.astro";

const fullBadgeSnippet = `<a rel="author" href="https://littleaicompany.com/" aria-label="A Little AI Company project">
  <img
    src="https://littleaicompany.com/brand/tlac-project-badge.svg"
    width="560"
    height="120"
    alt="A Little AI Company project"
  />
</a>`;
const compactBadgeSnippet = `<a rel="author" href="https://littleaicompany.com/" aria-label="A Little AI Company project">
  <img
    src="https://littleaicompany.com/brand/tlac-project-badge-compact.svg"
    width="360"
    height="88"
    alt="A Little AI Company project"
  />
</a>`;
const placementGuidance = [
  {
    title: "Footer or about page",
    body: "Use the full badge where visitors look for project identity, credits, or context.",
  },
  {
    title: "App chrome or docs sidebar",
    body: "Use the compact badge where space is tight but the parent label still helps.",
  },
  {
    title: "README or launch notes",
    body: "Use the linked snippet when a project needs crawler-readable attribution.",
  },
];
---

<BaseLayout
  title="Project Badge | The Little AI Company"
  description="Reusable Little AI Company project badge assets and embed snippets for child projects."
  canonicalPath="/project-badge/"
>
  <section class="page-section badge-page" aria-labelledby="badge-title">
    <div class="page-heading">
      <p class="eyebrow">Badge kit</p>
      <h1 id="badge-title">Project badge kit.</h1>
      <p class="lede">
        Exact SVG badges for child projects that should carry a clear
        <span>A Little AI Company project</span> attribution and link back home.
      </p>
    </div>

    <div class="badge-grid">
      <article class="badge-card">
        <div class="badge-preview">
          <img
            src="/brand/tlac-project-badge.svg"
            width="560"
            height="120"
            alt="A Little AI Company project badge"
          />
        </div>
        <h2>Full badge</h2>
        <p>Use this on a project homepage, about section, footer, or public docs page.</p>
        <a class="text-link compact-link" href="/brand/tlac-project-badge.svg">Open SVG asset</a>
        <pre class="code-block"><code>{fullBadgeSnippet}</code></pre>
      </article>

      <article class="badge-card">
        <div class="badge-preview compact">
          <img
            src="/brand/tlac-project-badge-compact.svg"
            width="360"
            height="88"
            alt="A Little AI Company project compact badge"
          />
        </div>
        <h2>Compact badge</h2>
        <p>Use this in tighter app surfaces, docs sidebars, or compact launch pages.</p>
        <a class="text-link compact-link" href="/brand/tlac-project-badge-compact.svg">
          Open compact SVG asset
        </a>
        <pre class="code-block"><code>{compactBadgeSnippet}</code></pre>
      </article>
    </div>

    <section class="badge-guidance" aria-labelledby="guidance-title">
      <div>
        <p class="eyebrow">Usage guidance</p>
        <h2 id="guidance-title">Use it as a label.</h2>
        <p>
          The badge gives visitors a clear parent-label trail while each project
          keeps its own name, repo, and maintainer context.
        </p>
      </div>
      <ul>
        {
          placementGuidance.map((item) => (
            <li>
              <strong>{item.title}</strong>
              <span>{item.body}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </section>
</BaseLayout>
