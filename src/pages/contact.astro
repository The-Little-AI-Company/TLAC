---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact"
  description="Reach The Little AI Company by email or on GitHub. Bug reports go to each tool's issue tracker."
>
  <section class="page-hero">
    <div class="wrap">
      <h1>Contact</h1>
      <p class="lede">One person answers this. Expect a reply within a few days.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <dl class="lanes">
        <div class="lane">
          <dt>Email</dt>
          <dd><a href="mailto:jeff@littleaicompany.com">jeff@littleaicompany.com</a></dd>
        </div>
        <div class="lane">
          <dt>Bugs</dt>
          <dd>
            Open an issue on the tool's repository: <a href="https://github.com/The-Little-AI-Company/callout/issues">Callout</a> or <a href="https://github.com/vivary-dev/vivary/issues">Vivary</a>.
          </dd>
        </div>
        <div class="lane">
          <dt>Security</dt>
          <dd>
            Email the address above with "security" in the subject. Don't open a public
            issue for a vulnerability.
          </dd>
        </div>
        <div class="lane">
          <dt>Elsewhere</dt>
          <dd>
            <a href="https://github.com/The-Little-AI-Company">GitHub</a>, <a href="https://x.com/JeffKazzee">X</a>, and <a href="https://bsky.app/profile/jeffkazzee.bsky.social">Bluesky</a>.
          </dd>
        </div>
      </dl>
    </div>
  </section>
</Base>

