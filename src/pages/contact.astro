---
import BaseLayout from '../layouts/BaseLayout.astro';

const email = 'jeffkazzee@gmail.com';
---

<BaseLayout
  title="Contact — The Little AI Company"
  description="Ask about practical AI workshops, agent coaching, workflow design, products, or collaborations."
>
  <section class="contact">
    <span class="eyebrow">// say hello</span>
    <h1>Get in touch.</h1>
    <p class="lede">
      Want help building practical AI skills, improving an agent workflow, or
      teaching a team? Have an idea, a collaboration, or feedback on one of the
      tools? Send a note.
    </p>
    <p class="email">
      <a class="btn btn-primary" href={`mailto:${email}`}>Email {email} →</a>
    </p>
    <p class="alt">
      Want to begin on your own? <a href="/start-here">Start with the free guides</a>.
      Looking for the software? <a href="/projects">Browse the projects</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .contact { max-width: 640px; margin: 0 auto; padding: 64px 0 48px; }
  .contact h1 { font-size: clamp(34px, 5.4vw, 56px); font-weight: 900; margin: 16px 0 0; }
  .lede { color: var(--muted); font-size: 19px; margin: 20px 0 28px; }
  .email { margin: 0 0 24px; }
  .email a { word-break: break-word; }
  .alt { color: var(--muted); font-size: 16px; }
  .alt a { color: var(--signal); }
</style>
