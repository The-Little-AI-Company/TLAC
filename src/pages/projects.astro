---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<BaseLayout
  title="Projects — The Little AI Company"
  description="Inspectable tools from The Little AI Company that support reliable learning and work with AI agents."
>
  <section class="projects-hero">
    <span class="eyebrow">// what we make</span>
    <h1>Tools that make better AI work possible.</h1>
    <p class="lede">
      The teaching comes first. These tools support the parts of reliable AI
      work that a prompt alone cannot solve: shared context, memory, handoffs,
      ownership, and evidence. Each project states where it is now and exposes
      enough of the work to inspect.
    </p>
  </section>

  <section class="project-list" aria-label="Current projects">
    <h2 class="visually-hidden">Current projects</h2>
    {projects.map((project) => <ProjectCard project={project} />)}
  </section>

  <section class="principles">
    <span class="eyebrow">// how we build</span>
    <div class="principle-grid">
      <article>
        <h2>Useful before impressive.</h2>
        <p>We start with a real job and ship the smallest thing that does it honestly.</p>
      </article>
      <article>
        <h2>Local and inspectable.</h2>
        <p>Your work should stay yours, and important system behavior should leave receipts.</p>
      </article>
      <article>
        <h2>Open where it matters.</h2>
        <p>Protocols, source, limitations, and release state should be visible enough to evaluate.</p>
      </article>
    </div>
  </section>

  <section class="learn">
    <div>
      <span class="eyebrow">// education is the work</span>
      <h2>The lessons come first.</h2>
      <p>
        The free Starter Kit teaches practical ways to use AI, check its work, and
        build something useful. The tools below grow from problems we encounter while teaching.
      </p>
    </div>
    <a class="btn btn-ghost" href="/guides">Browse the guides →</a>
  </section>
</BaseLayout>

<style>
  .projects-hero {
    max-width: 800px;
    padding: 64px 0 36px;
  }
  .projects-hero h1 {
    max-width: 13ch;
    margin-top: 16px;
    font-size: clamp(42px, 6.4vw, 70px);
    font-weight: 900;
  }
  .lede {
    max-width: 64ch;
    margin-top: 20px;
    color: var(--muted);
    font-size: 19px;
  }
  .project-list {
    display: grid;
    gap: 18px;
  }
  .principles {
    margin-top: 64px;
    padding-top: 42px;
    border-top: 1px solid var(--line);
  }
  .principle-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 20px;
  }
  .principle-grid article {
    padding: 22px;
    background: rgba(255, 253, 248, 0.58);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .principle-grid h2 {
    font-size: 21px;
    font-weight: 600;
  }
  .principle-grid p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 14.5px;
  }
  .learn {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 26px;
    margin-top: 54px;
    padding: 30px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 8px solid var(--coral);
    border-radius: var(--radius);
  }
  .learn h2 {
    margin-top: 8px;
    font-size: 28px;
    font-weight: 600;
  }
  .learn p {
    max-width: 62ch;
    margin-top: 8px;
    color: var(--muted);
  }
  .learn .btn { flex: none; }
  @media (max-width: 760px) {
    .principle-grid { grid-template-columns: 1fr; }
    .learn { align-items: flex-start; flex-direction: column; }
  }
</style>
