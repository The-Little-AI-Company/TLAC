---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import NowLine from '../components/NowLine.astro';
// Placeholder until the home page is rebuilt on the new components.
---

<Base
  title="The Little AI Company"
  description="I'm Jeff Kazzee. I build Callout, a hotkey that checks what you read, and Vivary, a desktop workspace for AI agents. Small tools that keep you in charge."
>
  <section class="page-head">
    <div class="wrap">
      <NowLine tone="wip">Now building Vivary. A Windows preview came out Sept 22.</NowLine>
      <h1 class="display-xl">Tools for the work you keep doing by hand.</h1>
      <p class="lede">
        I'm Jeff Kazzee. I build Callout, a hotkey that checks what you read, and Vivary, a desktop
        workspace for AI agents. Small tools that keep you in charge of the AI you use.
      </p>
      <div class="actions">
        <Button href="/callout/" variant="primary">Get Callout</Button>
        <Button href="/vivary/">See Vivary</Button>
      </div>
    </div>
  </section>
</Base>
