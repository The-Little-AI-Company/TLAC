---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Signup from '../components/Signup.astro';

const cards = [
  {
    img: '/brand/mascot/tlac-owl-welcome.webp',
    title: 'Your first useful thing',
    href: '/start-here',
    more: 'Start the build',
    body: 'Turn a messy real task into a finished artifact today — a build-along, not a list of ideas.',
  },
  {
    img: '/brand/mascot/tlac-owl-checking.webp',
    title: 'Know when AI is wrong',
    href: '/guides/is-ai-wrong',
    more: 'Get the checklist',
    body: 'A plain-English red-flags checklist for spotting when AI is confidently bluffing.',
  },
  {
    img: '/brand/mascot/tlac-owl-writing.webp',
    title: 'Prompts that actually work',
    href: '/guides/prompt-anatomy',
    more: 'Use the template',
    body: 'A fill-in-the-blank anatomy: role, context, task, format, example.',
  },
  {
    img: '/brand/mascot/tlac-owl-memory.webp',
    title: 'An AI second brain',
    href: '/guides',
    more: 'Explore the kit',
    body: 'Markdown-first notes that stick — useful in minutes, not a weekend setup project.',
  },
];
---

<BaseLayout>
  <section class="hero">
    <div>
      <span class="eyebrow">// practical AI education</span>
      <h1>Learn AI by making useful things.</h1>
      <p class="lede">
        No hype. No jargon. No computer-science degree. Bring one real task and leave
        with something useful you made with AI — plus the judgment to know when to trust it.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="/start-here">Start Here →</a>
        <a class="btn btn-ghost" href="#make">See what you can make</a>
      </div>
      <p class="kitline">
        <a class="kitlink" href="/guides">Get the free Starter Kit →</a>
      </p>
      <small class="hint">Free: 7 plain-English guides — a prompt template, the “is AI wrong?” checklist, and more. No email needed.</small>
    </div>
    <div class="heroart">
      <img
        src="/brand/mascot/tlac-owl-welcome.webp"
        alt="The Little AI Company owl waving hello"
        width="420"
        height="420"
      />
    </div>
  </section>

  <section id="make" class="make">
    <h2>What you can make</h2>
    <p class="sub">Four first wins — each a real artifact you’ll actually use.</p>
    <div class="grid">
      {cards.map((c) => <Card img={c.img} title={c.title} href={c.href} more={c.more}>{c.body}</Card>)}
    </div>
  </section>

  <section class="home-signup">
    <h2>Get useful things by email</h2>
    <p>New guides and the occasional genuinely-useful AI tip — no spam, no hype.</p>
    <Signup source="home-newsletter" subject="TLAC newsletter signup" cta="Subscribe" />
  </section>

  <p class="trust">
    <img
      src="/brand/mascot/tlac-owl-coffee.webp"
      alt=""
      width="64"
      height="64"
      loading="lazy"
    />
    <span>Model-agnostic. Beginner-first. Built around <b>useful artifacts</b>, not tool hype.</span>
  </p>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 30px;
    align-items: center;
    padding: 64px 0 40px;
  }
  .hero .eyebrow { display: block; margin-bottom: 18px; }
  .hero h1 { font-size: clamp(40px, 5.6vw, 66px); font-weight: 900; max-width: 13ch; }
  .lede { font-size: 18.5px; color: var(--muted); max-width: 52ch; margin-top: 20px; }
  .cta { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
  .kitline { margin-top: 22px; }
  .kitlink { display: inline-block; font-weight: 700; color: var(--signal); text-decoration: none; font-size: 16px; }
  .kitlink:hover { text-decoration: underline; }
  .hint { display: block; margin-top: 8px; color: var(--muted); font-size: 13px; }
  .heroart { display: grid; place-items: center; }
  .heroart img {
    width: 420px; height: auto;
    filter: drop-shadow(0 10px 18px rgba(33, 29, 23, 0.10));
  }
  .make { padding: 60px 0 20px; border-top: 1px solid var(--line); margin-top: 34px; }
  .make h2 { font-size: 32px; font-weight: 600; }
  .sub { color: var(--muted); margin: 6px 0 32px; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .home-signup {
    margin-top: 40px;
    padding: 30px 0 6px;
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .home-signup h2 { font-size: 26px; font-weight: 600; }
  .home-signup p { color: var(--muted); margin: 8px auto 18px; max-width: 48ch; }
  .home-signup :global(.signup) { margin-inline: auto; }
  .trust {
    display: flex;
    align-items: center;
    gap: 14px;
    justify-content: center;
    text-align: center;
    color: var(--muted);
    font-size: 15px;
    padding: 40px 0 20px;
  }
  .trust b { color: var(--green); }
  .trust img { width: 64px; height: 64px; object-fit: contain; }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; }
    .heroart { order: -1; }
    .heroart img { width: 280px; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
