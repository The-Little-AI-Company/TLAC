---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Signup from '../components/Signup.astro';
import { projects } from '../data/projects';
---

<BaseLayout
  title="The Little AI Company — Practical AI skills and reliable agents"
  description="Plain-English AI education, hands-on help, and inspectable tools for non-technical people who want to use AI and AI agents reliably."
>
  <section class="hero">
    <div>
      <span class="eyebrow">// practical AI education and tools</span>
      <h1>Learn to use AI and AI agents with more skill — and less guesswork.</h1>
      <p class="lede">
        We help non-technical people turn AI into useful, reliable work through
        plain-English guides, hands-on workshops, and inspectable tools. Build
        capability. Check the work. Keep control.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="/start-here">Start learning →</a>
        <a class="btn btn-ghost" href="/services">Work with us</a>
      </div>
      <p class="learnline">
        Already experimenting? <a href="/guides">Browse the practical guides →</a>
      </p>
    </div>
    <div class="heroart">
      <img
        src="/brand/mascot/tlac-owl-teaching.webp"
        alt="The Little AI Company owl teaching practical AI skills"
        width="420"
        height="420"
      />
    </div>
  </section>

  <section class="field-notes">
    <div>
      <span class="eyebrow">// learn by doing</span>
      <h2>Build practical AI fluency.</h2>
      <p>
        Learn how to choose useful tasks, give AI the right context, check its
        output, protect private information, build repeatable workflows, and
        work with agents without handing over your judgment.
      </p>
      <a class="more" href="/guides">Use the free AI Starter Kit →</a>
    </div>
    <img
      src="/brand/mascot/tlac-owl-writing.webp"
      alt=""
      width="190"
      height="190"
      loading="lazy"
    />
  </section>

  <section class="work">
    <div class="section-heading">
      <div>
        <span class="eyebrow">// supporting tools</span>
        <h2>Tools from the workshop</h2>
      </div>
      <a href="/projects">All projects →</a>
    </div>
    <div class="project-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="home-signup">
    <h2>Learn and build with us.</h2>
    <p>Practical guides, workshop notes, and useful tools — sent when there is something worth sharing.</p>
    <Signup source="home-newsletter" subject="TLAC build notes signup" cta="Keep me posted" />
  </section>

  <p class="trust">
    <img
      src="/brand/mascot/tlac-owl-coffee.webp"
      alt=""
      width="64"
      height="64"
      loading="lazy"
    />
    <span>Practical skills. Inspectable tools. <b>Better AI judgment.</b></span>
  </p>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 30px;
    align-items: center;
    padding: 64px 0 40px;
  }
  .hero .eyebrow { display: block; margin-bottom: 18px; }
  .hero h1 { font-size: clamp(40px, 5.6vw, 66px); font-weight: 900; max-width: 15ch; }
  .lede { font-size: 18.5px; color: var(--muted); max-width: 52ch; margin-top: 20px; }
  .cta { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
  .learnline { margin-top: 22px; color: var(--muted); font-size: 14px; }
  .learnline a { color: var(--signal); font-weight: 700; text-decoration: none; }
  .learnline a:hover { text-decoration: underline; }
  .heroart { display: grid; place-items: center; }
  .heroart img {
    width: 420px; height: auto;
    filter: drop-shadow(0 10px 18px rgba(33, 29, 23, 0.10));
  }
  .work { padding: 60px 0 20px; border-top: 1px solid var(--line); margin-top: 34px; }
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }
  .section-heading h2 { margin-top: 7px; font-size: 36px; font-weight: 600; }
  .section-heading > a, .more {
    color: var(--signal);
    font-weight: 700;
    text-decoration: none;
  }
  .section-heading > a:hover, .more:hover { text-decoration: underline; }
  .project-grid { display: grid; gap: 18px; }
  .field-notes {
    display: grid;
    grid-template-columns: 1fr 190px;
    gap: 30px;
    align-items: center;
    margin-top: 34px;
    padding: 30px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 8px solid var(--coral);
    border-radius: var(--radius);
  }
  .field-notes h2 { margin-top: 8px; font-size: 30px; font-weight: 600; }
  .field-notes p { max-width: 62ch; margin: 10px 0 14px; color: var(--muted); }
  .field-notes img { width: 190px; height: 190px; object-fit: contain; }
  .home-signup {
    margin-top: 48px;
    padding: 30px 0 6px;
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .home-signup h2 { font-size: 26px; font-weight: 600; }
  .home-signup p { color: var(--muted); margin: 8px auto 18px; max-width: 48ch; }
  .home-signup :global(.signup) { margin-inline: auto; }
  .trust {
    display: flex;
    align-items: center;
    gap: 14px;
    justify-content: center;
    text-align: center;
    color: var(--muted);
    font-size: 15px;
    padding: 40px 0 20px;
  }
  .trust b { color: var(--green); }
  .trust img { width: 64px; height: 64px; object-fit: contain; }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; }
    .heroart { order: -1; }
    .heroart img { width: 280px; }
    .field-notes { grid-template-columns: 1fr; }
    .field-notes img { grid-row: 1; width: 130px; height: 130px; }
  }
</style>
