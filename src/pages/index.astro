---
import "../styles/global.css";
import logoConcept from "../../assets/brand/generated/2026-06-21/logo-concepts/tlac-logo-concept-05-folded-spark.png";
import { featuredProject } from "../data/projects";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="The Little AI Company is a one-person AI studio by Jeff Kazzee that makes useful AI tools, apps, and learning surfaces."
    />
    <title>The Little AI Company</title>
  </head>
  <body>
    <div class="page">
      <header class="site-header" aria-label="Site header">
        <a class="brand" href="/" aria-label="The Little AI Company home">
          <img src={logoConcept.src} width="88" height="88" alt="" loading="eager" />
          <span>The Little AI Company</span>
        </a>
        <nav class="nav" aria-label="Primary navigation">
          <a href="#projects">Projects</a>
          <a href="#about">About</a>
        </nav>
      </header>

      <main>
        <section id="about" class="hero" aria-labelledby="page-title">
          <div>
            <p class="eyebrow">The Little AI Company is a one-person AI studio by Jeff Kazzee.</p>
            <h1 id="page-title">Useful things, made by hand and machine.</h1>
            <p class="lede">
              It is a selective label for practical AI tools, apps, and learning
              surfaces. It is not the full Jeff Kazzee portfolio; it is the lane
              where useful AI work gets a clear public home.
            </p>
            <div class="actions" aria-label="Primary actions">
              <a class="button" href="#projects">See the first projects</a>
              <a class="button secondary" href="#about">Read the boundary</a>
            </div>
          </div>

          <aside class="mark-panel" aria-label="Brand and project facts">
            <div class="mark-card">
              <img
                src={logoConcept.src}
                width={logoConcept.width}
                height={logoConcept.height}
                alt="Abstract TLAC mark concept made from blue, amber, green, and red folded panels."
                loading="eager"
              />
            </div>
            <div class="facts">
              <div class="fact">
                <strong>Lane</strong>
                <span>Useful AI work</span>
              </div>
              <div class="fact">
                <strong>Shape</strong>
                <span>Static, fast, plain</span>
              </div>
              <div class="fact">
                <strong>Proof</strong>
                <span>Projects and updates</span>
              </div>
              <div class="fact">
                <strong>Boundary</strong>
                <span>Not a resume site</span>
              </div>
            </div>
          </aside>
        </section>

        <section id="projects" class="proof-strip" aria-labelledby="projects-title">
          <div class="section-heading">
            <p class="eyebrow">First proof point</p>
            <h2 id="projects-title">One useful project with a clear lane.</h2>
          </div>

          <article class="proof-card featured-project">
            <div class="project-meta">
              <span>{featuredProject.category}</span>
              <span>{featuredProject.status}</span>
            </div>
            <h3>{featuredProject.title}</h3>
            <p>{featuredProject.summary}</p>
            <p>{featuredProject.proof}</p>
            <div class="project-footer">
              <div class="swatches" aria-hidden="true">
                {
                  featuredProject.palette.map((color) => (
                    <span class={color}></span>
                  ))
                }
              </div>
              {
                featuredProject.links.map((link) => (
                  <a href={link.href}>{link.label}</a>
                ))
              }
            </div>
          </article>
        </section>
      </main>
    </div>
  </body>
</html>
