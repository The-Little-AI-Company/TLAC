---
import logoConcept from "../../assets/brand/generated/2026-06-21/logo-concepts/tlac-logo-concept-05-folded-spark.png";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { statusLabels } from "../site/projects";

const projects = await getCollection("projects");
const updates = await getCollection("updates");
const featuredEntry = projects.find((project) => project.data.featured) ?? projects[0];
const latestUpdate = [...updates].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)[0];
const dateFormatter = new Intl.DateTimeFormat("en", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});

if (!featuredEntry) {
  throw new Error("Expected at least one project entry.");
}

const featuredProject = featuredEntry.data;
---

<BaseLayout>
  <section id="about" class="hero" aria-labelledby="page-title">
    <div>
      <p class="eyebrow">The Little AI Company is a one-person AI studio by Jeff Kazzee.</p>
      <h1 id="page-title">Useful things, made by hand and machine.</h1>
      <p class="lede">
        It makes practical AI tools, small apps, and learning surfaces for
        people who want clearer, calmer ways to work with AI.
      </p>
      <div class="actions" aria-label="Primary actions">
        <a class="button" href="/projects/">See the first projects</a>
        <a class="button secondary" href="/about/">Meet the studio</a>
      </div>
    </div>

    <aside class="mark-panel" aria-label="Brand and project facts">
      <div class="mark-card">
        <img
          src={logoConcept.src}
          width={logoConcept.width}
          height={logoConcept.height}
          alt="Abstract TLAC mark concept made from blue, amber, green, and red folded panels."
          loading="eager"
        />
      </div>
      <div class="facts">
        <div class="fact">
          <strong>Studio</strong>
          <span>One-person AI company</span>
        </div>
        <div class="fact">
          <strong>Shape</strong>
          <span>Static, fast, plain</span>
        </div>
        <div class="fact">
          <strong>Proof</strong>
          <span>Projects and updates</span>
        </div>
        <div class="fact">
          <strong>Tone</strong>
          <span>Warm and practical</span>
        </div>
      </div>
    </aside>
  </section>

  <section id="projects" class="proof-strip" aria-labelledby="projects-title">
    <div class="section-heading">
      <p class="eyebrow">First proof point</p>
      <h2 id="projects-title">One useful project with a clear purpose.</h2>
    </div>

    <article class="proof-card featured-project">
      <div class="project-meta">
        <span>{featuredProject.category}</span>
        <span>{statusLabels[featuredProject.status]}</span>
      </div>
      <h3>{featuredProject.title}</h3>
      <p>{featuredProject.purpose}</p>
      <p>{featuredProject.leveledUp}</p>
      <div class="project-footer">
        <div class="swatches" aria-hidden="true">
          {
            featuredProject.palette.map((color) => (
              <span class={color}></span>
            ))
          }
        </div>
        {
          featuredProject.links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))
        }
        <a href="/projects/">View all projects</a>
      </div>
    </article>
  </section>

  {
    latestUpdate && (
      <section class="updates-strip" aria-labelledby="latest-update-title">
        <div class="section-heading">
          <p class="eyebrow">Latest update</p>
          <h2 id="latest-update-title">Small notes as the work gets sharper.</h2>
        </div>

        <article class="latest-update">
          <time datetime={latestUpdate.data.date.toISOString()}>
            {dateFormatter.format(latestUpdate.data.date)}
          </time>
          <h3>{latestUpdate.data.title}</h3>
          <p>{latestUpdate.data.summary}</p>
          <a href="/updates/">Read updates</a>
        </article>
      </section>
    )
  }
</BaseLayout>
