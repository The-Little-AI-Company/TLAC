---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { statusLabels } from "../site/projects";

const projects = await getCollection("projects");
const projectsById = new Map(projects.map((project) => [project.id, project]));
const learningProjectIds = [
  "zo-101",
  "designdojo",
  "cookbook",
  "the-token-repository",
] as const;
const learningIntents = {
  "zo-101": {
    kicker: "First step",
    heading: "Try one useful session.",
    body: "For people who want a calm first path before the tool names and jargon pile up.",
  },
  designdojo: {
    kicker: "Practice",
    heading: "Build better taste with reps.",
    body: "For people using AI to make visual or product work and wanting sharper judgment.",
  },
  cookbook: {
    kicker: "Workflow",
    heading: "Reuse what works.",
    body: "For people who want practical recipes they can repeat, adapt, and check.",
  },
  "the-token-repository": {
    kicker: "Mechanics",
    heading: "Understand the hidden limits.",
    body: "For people who want plain explanations of tokens, context, and model tradeoffs.",
  },
} as const;
const learningProjects = learningProjectIds.map((id) => {
  const project = projectsById.get(id);

  if (!project) {
    throw new Error(`Expected learning project "${id}" to exist.`);
  }

  return {
    id,
    project,
    intent: learningIntents[id],
  };
});
const principles = [
  {
    title: "Small enough to try",
    body: "The best first step should fit inside a real work session, not a huge course.",
  },
  {
    title: "Specific enough to repeat",
    body: "Good AI learning leaves behind a reusable workflow, checklist, or habit.",
  },
  {
    title: "Honest about stage",
    body: "Planned and research surfaces are labeled clearly so visitors know what is ready.",
  },
];
---

<BaseLayout
  title="Learn | The Little AI Company"
  description="Plain-spoken learning surfaces from The Little AI Company for AI-curious visitors."
  canonicalPath="/learn/"
>
  <section class="page-section learn-page" aria-labelledby="learn-title">
    <header class="learn-hero">
      <div>
        <p class="eyebrow">Learning surfaces</p>
        <h1 id="learn-title">Start using AI with less noise.</h1>
        <p class="lede">
          A calm path for people who want useful first steps, better practice
          habits, and simple explanations of how AI tools behave.
        </p>
      </div>
      <div class="learn-audience" aria-label="Who this page is for">
        <div>
          <strong>New to AI</strong>
          <span>Start with one practical session.</span>
        </div>
        <div>
          <strong>Building taste</strong>
          <span>Practice with examples and critique.</span>
        </div>
        <div>
          <strong>Working repeatedly</strong>
          <span>Turn useful attempts into workflows.</span>
        </div>
      </div>
    </header>

    <section class="learn-path" aria-labelledby="learning-path-title">
      <div class="section-kicker">
        <p class="eyebrow">Where to begin</p>
        <h2 id="learning-path-title">Choose the next small step.</h2>
      </div>
      <div class="learning-grid">
        {
          learningProjects.map(({ project, intent }) => (
            <article class="learning-card">
              <p class="eyebrow">{intent.kicker}</p>
              <h3>{intent.heading}</h3>
              <p>{intent.body}</p>
              <div class="project-meta">
                <span>{project.data.category}</span>
                <span>{statusLabels[project.data.status]}</span>
              </div>
              <p>{project.data.purpose}</p>
              <a class="text-link compact-link" href={`/projects/${project.id}/`}>
                Open {project.data.title}
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="learn-principles" aria-labelledby="principles-title">
      <div>
        <p class="eyebrow">Style</p>
        <h2 id="principles-title">The learning stays practical.</h2>
      </div>
      <ul>
        {
          principles.map((principle) => (
            <li>
              <strong>{principle.title}</strong>
              <span>{principle.body}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </section>
</BaseLayout>
