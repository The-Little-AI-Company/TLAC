{
  "name": "tlac-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check --minimumFailingSeverity hint",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "verify": "pnpm check && pnpm build && pnpm test && pnpm test:e2e",
    "images": "node scripts/images.mjs",
    "og": "node scripts/og.mjs",
    "icons": "node scripts/icons.mjs",
    "screenshots": "playwright test --project=screenshots"
  },
  "dependencies": {
    "astro": "^7.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^26.0.1",
    "html-validate": "^11.16.2",
    "node-html-parser": "^9.0.4",
    "sharp": "0.34.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
